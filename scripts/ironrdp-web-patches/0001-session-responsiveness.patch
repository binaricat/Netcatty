+/// Minimum interval (ms) between canvas blits. Graphics updates are coalesced
+/// into a single dirty bounding rectangle and flushed at most this often.
+const DRAW_INTERVAL_MS: u32 = 16;
+
+/// Maximum number of RDP frames processed before cooperatively yielding back
+/// to the browser event loop so DOM keyboard/mouse events are never starved.
+const MAX_FRAMES_PER_YIELD: u32 = 16;
+
+/// One-shot timer that gives a coalesced dirty region a paint deadline without
+/// waking an idle session every 16ms.
+struct PaintTicker {
+    delay: u32,
+    armed: Rc<Cell<bool>>,
+    deadline: Option<TimeoutFuture>,
+}
+
+/// Handle used to arm a [`PaintTicker`] from inside the session loop while the
+/// ticker itself is borrowed by `select!`.
+#[derive(Clone)]
+struct PaintTrigger(Rc<Cell<bool>>);
+
+impl PaintTrigger {
+    fn trigger(&self) {
+        self.0.set(true);
+    }
+}
+
+impl PaintTicker {
+    fn new(delay: u32) -> (Self, PaintTrigger) {
+        let armed = Rc::new(Cell::new(false));
+        let trigger = PaintTrigger(Rc::clone(&armed));
+        let this = Self {
+            delay,
+            armed,
+            deadline: None,
+        };
+        (this, trigger)
+    }
+}
+
+impl Stream for PaintTicker {
+    type Item = ();
+
+    fn poll_next(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<()>> {
+        let this = self.get_mut();
+
+        if !this.armed.get() {
+            this.deadline = None;
+            return Poll::Pending;
+        }
+
+        let deadline = this.deadline.get_or_insert_with(|| TimeoutFuture::new(this.delay));
+
+        match Pin::new(deadline).poll(cx) {
+            Poll::Ready(()) => {
+                this.deadline = None;
+                this.armed.set(false);
+                Poll::Ready(Some(()))
+            }
+            Poll::Pending => Poll::Pending,
+        }
+    }
+}
+
+/// Smallest inclusive rectangle containing both `a` and `b`.
+fn union_rect(a: InclusiveRectangle, b: InclusiveRectangle) -> InclusiveRectangle {
+    InclusiveRectangle {
+        left: a.left.min(b.left),
+        top: a.top.min(b.top),
+        right: a.right.max(b.right),
+        bottom: a.bottom.max(b.bottom),
+    }
+}

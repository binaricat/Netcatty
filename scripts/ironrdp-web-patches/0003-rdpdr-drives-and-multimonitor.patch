+    fn remove_drive_cancels_pending_irps_and_reset_drops_stale_responses() {
+        let (tx, mut rx) = mpsc::unbounded();
+        let mut backend = WasmDriveBackend::new(tx);
+        backend.add_drive(10).unwrap();
+        backend.add_drive(11).unwrap();
+
+        backend
+            .handle_drive_io_request(ServerDriveIoRequest::DeviceReadRequest(DeviceReadRequest {
+                device_io_request: make_io_req(10, 1, 500, MajorFunction::Read),
+                length: 64,
+                offset: 0,
+            }))
+            .unwrap();
+        backend
+            .handle_drive_io_request(ServerDriveIoRequest::DeviceReadRequest(DeviceReadRequest {
+                device_io_request: make_io_req(11, 2, 501, MajorFunction::Read),
+                length: 64,
+                offset: 0,
+            }))
+            .unwrap();
+        let _ = rx.try_recv().unwrap();
+        let _ = rx.try_recv().unwrap();
+
+        let cancelled = backend.remove_drive(10).unwrap();
+        assert_eq!(cancelled.len(), 1);
+        let encoded = cancelled[0].encode_unframed_pdu().unwrap();
+        let (_, _, dev, cid, st) = decode_completion_header(&encoded);
+        assert_eq!((dev, cid, st), (10, 500, 0xC000_0120));
+
+        // Stale completion for removed drive 10 is ignored
+        assert!(
+            backend
+                .complete_response(DriveResponse::Read {
+                    device_id: 10,
+                    completion_id: 500,
+                    status: NtStatus::SUCCESS,
+                    data: vec![1, 2, 3],
+                })
+                .unwrap()
+                .is_none()
+        );
+
+        // Reset clears remaining pending IRPs and notifies JS
+        backend.reset().unwrap();
+        assert!(matches!(
+            rx.try_recv().unwrap(),
+            RdpInputEvent::DriveRequest(DriveBackendMessage::Reset)
+        ));
+        backend.restore_drive(11).unwrap();
+        assert!(
+            backend
+                .complete_response(DriveResponse::Read {
+                    device_id: 11,
+                    completion_id: 501,
+                    status: NtStatus::SUCCESS,
+                    data: vec![4, 5],
+                })
+                .unwrap()
+                .is_none()
+        );
+    }

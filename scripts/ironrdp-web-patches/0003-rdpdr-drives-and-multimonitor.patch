+impl RdpdrBackend for WasmDriveBackend {
+    fn reset(&mut self) -> PduResult<()> {
+        debug!(
+            pending_irps = self.pending_irps.len(),
+            active_drives = self.active_drives.len(),
+            "Resetting WasmDriveBackend state for new RDPDR sequence"
+        );
+        self.pending_irps.clear();
+        self.active_drives.clear();
+        if let Some(printer) = self.printer.as_mut() {
+            printer.reset()?;
+        }
+        let _ = self.send_to_loop(DriveBackendMessage::Reset);
+        Ok(())
+    }
+
+    fn restore_drive(&mut self, device_id: u32) -> PduResult<()> {
+        debug!(device_id, "Restoring redirected drive after RDPDR reset");
+        self.active_drives.insert(device_id);
+        Ok(())
+    }
+
+    fn add_drive(&mut self, device_id: u32) -> PduResult<()> {
+        debug!(device_id, "Activating dynamic redirected drive");
+        self.active_drives.insert(device_id);
+        Ok(())
+    }
+
+    fn remove_drive(&mut self, device_id: u32) -> PduResult<Vec<SvcMessage>> {
+        debug!(device_id, "Removing redirected drive and cancelling pending IRPs");
+        self.active_drives.remove(&device_id);
+        let keys: Vec<(u32, u32)> = self
+            .pending_irps
+            .keys()
+            .copied()
+            .filter(|(dev_id, _)| *dev_id == device_id)
+            .collect();
+        let mut cancelled = Vec::with_capacity(keys.len());
+        for key in keys {
+            if let Some(pending) = self.pending_irps.remove(&key) {
+                cancelled.push(pending.cancel_message()?);
+            }
+        }
+        Ok(cancelled)
+    }
+
+    fn handle_server_device_announce_response(&mut self, pdu: ServerDeviceAnnounceResponse) -> PduResult<()> {
+        if self.active_drives.contains(&pdu.device_id) {
+            if pdu.result_code == NtStatus::SUCCESS {
+                debug!(device_id = pdu.device_id, "RDPDR drive announce accepted by server");
+            } else {
+                warn!(
+                    device_id = pdu.device_id,
+                    result_code = ?pdu.result_code,
+                    "RDPDR drive announce rejected by server"
+                );
+            }
+            return Ok(());
+        }
+        if let Some(printer) = self.printer.as_mut() {
+            return printer.handle_server_device_announce_response(pdu);
+        }
+        if pdu.result_code != NtStatus::SUCCESS {
+            warn!(
+                device_id = pdu.device_id,
+                result_code = ?pdu.result_code,
+                "RDPDR device announce rejected by server"
+            );
+        }
+        Ok(())
+    }
+
+    fn handle_scard_call(
+        &mut self,
+        _req: DeviceControlRequest<ScardIoCtlCode>,
+        _call: ScardCall,
+    ) -> PduResult<Vec<SvcMessage>> {
+        warn!("Smartcard IOCTL reached drive backend; ignoring");
+        Ok(Vec::new())
+    }
+
+    fn handle_drive_device_control(
+        &mut self,
+        req: DecodedDeviceControlRequest<AnyIoCtlCode>,
+    ) -> PduResult<Vec<SvcMessage>> {
+        let io_req = req.request.header;
+        let device_id = io_req.device_id;
+        let file_id = io_req.file_id;
+        let completion_id = io_req.completion_id;
+        let payload = DriveRequestPayload::DeviceControl {
+            device_id,
+            file_id,
+            completion_id,
+            io_control_code: req.request.io_control_code.0,
+            output_buffer_length: req.request.output_buffer_length,
+            input_buffer: req.input_buffer,
+        };
+        if !self.send_to_loop(DriveBackendMessage::Request(payload)) {
+            return Ok(vec![SvcMessage::from(RdpdrPdu::DeviceControlResponse(
+                DeviceControlResponse {
+                    device_io_reply: DeviceIoResponse::new(io_req, NtStatus::UNSUCCESSFUL),
+                    output_buffer: None,
+                },
+            ))]);
+        }
+        self.pending_irps
+            .insert((device_id, completion_id), PendingDriveIrp::DeviceControl(io_req));
+        Ok(Vec::new())
+    }
+
+    fn handle_drive_io_request(&mut self, req: ServerDriveIoRequest) -> PduResult<Vec<SvcMessage>> {
+        trace!(?req, "Forwarding RDPDR drive IRP to JS");
+        match req {
+            ServerDriveIoRequest::ServerDriveQuerySecurityRequest(req_inner) => {
+                return Ok(vec![SvcMessage::from(RdpdrPdu::ClientDriveQuerySecurityResponse(
+                    ClientDriveQuerySecurityResponse {
+                        device_io_response: DeviceIoResponse::new(req_inner.device_io_request, NtStatus::NOT_SUPPORTED),
+                        security_descriptor: None,
+                    },
+                ))]);
+            }
+            ServerDriveIoRequest::ServerDriveSetSecurityRequest(req_inner) => {
+                let response = ClientDriveSetSecurityResponse::new(&req_inner, NtStatus::NOT_SUPPORTED)
+                    .map_err(|e| encode_err!(e))?;
+                return Ok(vec![SvcMessage::from(RdpdrPdu::ClientDriveSetSecurityResponse(
+                    response,
+                ))]);
+            }
+            _ => {}
+        }
+
+        let (key, pending, payload) = match req {
+            ServerDriveIoRequest::ServerCreateDriveRequest(r) => {
+                let io_req = r.device_io_request;
+                let key = (io_req.device_id, io_req.completion_id);
+                let payload = DriveRequestPayload::Create {
+                    device_id: io_req.device_id,
+                    file_id: io_req.file_id,
+                    completion_id: io_req.completion_id,
+                    path: r.path,
+                    desired_access: r.desired_access.bits(),
+                    allocation_size: r.allocation_size,
+                    file_attributes: r.file_attributes.bits(),
+                    shared_access: r.shared_access.bits(),
+                    create_disposition: u32::from(r.create_disposition),
+                    create_options: r.create_options.bits(),
+                };
+                (key, PendingDriveIrp::Create(io_req), payload)
+            }
+            ServerDriveIoRequest::DeviceCloseRequest(r) => {
+                let io_req = r.device_io_request;
+                let key = (io_req.device_id, io_req.completion_id);
+                let payload = DriveRequestPayload::Close {
+                    device_id: io_req.device_id,
+                    file_id: io_req.file_id,
+                    completion_id: io_req.completion_id,
+                };
+                (key, PendingDriveIrp::Close(io_req), payload)
+            }
+            ServerDriveIoRequest::DeviceReadRequest(r) => {
+                let io_req = r.device_io_request;
+                let key = (io_req.device_id, io_req.completion_id);
+                let payload = DriveRequestPayload::Read {
+                    device_id: io_req.device_id,
+                    file_id: io_req.file_id,
+                    completion_id: io_req.completion_id,
+                    offset: r.offset,
+                    length: r.length,
+                };
+                (key, PendingDriveIrp::Read(io_req), payload)
+            }
+            ServerDriveIoRequest::DeviceWriteRequest(r) => {
+                let io_req = r.device_io_request;
+                let key = (io_req.device_id, io_req.completion_id);
+                let payload = DriveRequestPayload::Write {
+                    device_id: io_req.device_id,
+                    file_id: io_req.file_id,
+                    completion_id: io_req.completion_id,
+                    offset: r.offset,
+                    data: r.write_data,
+                };
+                (key, PendingDriveIrp::Write(io_req), payload)
+            }
+            ServerDriveIoRequest::ServerDriveQueryDirectoryRequest(r) => {
+                let io_req = r.device_io_request;
+                let key = (io_req.device_id, io_req.completion_id);
+                let info_class = r.file_info_class_lvl;
+                let payload = DriveRequestPayload::QueryDirectory {
+                    device_id: io_req.device_id,
+                    file_id: io_req.file_id,
+                    completion_id: io_req.completion_id,
+                    information_class: u32::from(info_class.clone()),
+                    initial_query: r.initial_query != 0,
+                    path: r.path,
+                };
+                (
+                    key,
+                    PendingDriveIrp::QueryDirectory { io_req, info_class },
+                    payload,
+                )
+            }
+            ServerDriveIoRequest::ServerDriveQueryInformationRequest(r) => {
+                let io_req = r.device_io_request;
+                let key = (io_req.device_id, io_req.completion_id);
+                let info_class = r.file_info_class_lvl;
+                let payload = DriveRequestPayload::QueryInformation {
+                    device_id: io_req.device_id,
+                    file_id: io_req.file_id,
+                    completion_id: io_req.completion_id,
+                    information_class: u32::from(info_class.clone()),
+                };
+                (
+                    key,
+                    PendingDriveIrp::QueryInformation { io_req, info_class },
+                    payload,
+                )
+            }
+            ServerDriveIoRequest::ServerDriveQueryVolumeInformationRequest(r) => {
+                let io_req = r.device_io_request;
+                let key = (io_req.device_id, io_req.completion_id);
+                let fs_info_class = r.fs_info_class_lvl;
+                let payload = DriveRequestPayload::QueryVolumeInformation {
+                    device_id: io_req.device_id,
+                    file_id: io_req.file_id,
+                    completion_id: io_req.completion_id,
+                    information_class: u32::from(fs_info_class.clone()),
+                };
+                (
+                    key,
+                    PendingDriveIrp::QueryVolumeInformation { io_req, fs_info_class },
+                    payload,
+                )
+            }
+            ServerDriveIoRequest::ServerDriveSetInformationRequest(r) => {
+                let device_id = r.device_io_request.device_id;
+                let file_id = r.device_io_request.file_id;
+                let completion_id = r.device_io_request.completion_id;
+                let key = (device_id, completion_id);
+                let (information_class, data) = match &r.set_buffer {
+                    FileInformationClass::Basic(info) => (
+                        u32::from(FileInformationClassLevel::FILE_BASIC_INFORMATION),
+                        SetInformationPayload::Basic {
+                            creation_time: info.creation_time,
+                            last_access_time: info.last_access_time,
+                            last_write_time: info.last_write_time,
+                            change_time: info.change_time,
+                            file_attributes: info.file_attributes.bits(),
+                        },
+                    ),
+                    FileInformationClass::Rename(info) => (
+                        u32::from(FileInformationClassLevel::FILE_RENAME_INFORMATION),
+                        SetInformationPayload::Rename {
+                            replace_if_exists: info.replace_if_exists == Boolean::True,
+                            rename_target: info.file_name.clone(),
+                        },
+                    ),
+                    FileInformationClass::Disposition(info) => (
+                        u32::from(FileInformationClassLevel::FILE_DISPOSITION_INFORMATION),
+                        SetInformationPayload::Disposition {
+                            delete_on_close: info.delete_pending != 0,
+                        },
+                    ),
+                    FileInformationClass::Allocation(info) => (
+                        u32::from(FileInformationClassLevel::FILE_ALLOCATION_INFORMATION),
+                        SetInformationPayload::Allocation {
+                            allocation_size: info.allocation_size,
+                        },
+                    ),
+                    FileInformationClass::EndOfFile(info) => (
+                        u32::from(FileInformationClassLevel::FILE_END_OF_FILE_INFORMATION),
+                        SetInformationPayload::EndOfFile {
+                            eof_size: info.end_of_file,
+                        },
+                    ),
+                    _ => (0, SetInformationPayload::Other),
+                };
+                let payload = DriveRequestPayload::SetInformation {
+                    device_id,
+                    file_id,
+                    completion_id,
+                    information_class,
+                    data,
+                };
+                (key, PendingDriveIrp::SetInformation(r), payload)
+            }
+            ServerDriveIoRequest::DeviceFlushBuffersRequest(r) => {
+                let io_req = r.device_io_request;
+                let key = (io_req.device_id, io_req.completion_id);
+                let payload = DriveRequestPayload::Flush {
+                    device_id: io_req.device_id,
+                    file_id: io_req.file_id,
+                    completion_id: io_req.completion_id,
+                };
+                (key, PendingDriveIrp::Flush(io_req), payload)
+            }
+            ServerDriveIoRequest::ServerDriveLockControlRequest(r) => {
+                let io_req = r.device_io_request;
+                let key = (io_req.device_id, io_req.completion_id);
+                let payload = DriveRequestPayload::LockControl {
+                    device_id: io_req.device_id,
+                    file_id: io_req.file_id,
+                    completion_id: io_req.completion_id,
+                    operation: u32::from(r.operation),
+                    wait: r.wait,
+                    locks: r.locks.into_iter().map(|l| (l.offset, l.length)).collect(),
+                };
+                (key, PendingDriveIrp::LockControl(io_req), payload)
+            }
+            ServerDriveIoRequest::DeviceControlRequest(r) => {
+                let io_req = r.header;
+                let key = (io_req.device_id, io_req.completion_id);
+                let payload = DriveRequestPayload::DeviceControl {
+                    device_id: io_req.device_id,
+                    file_id: io_req.file_id,
+                    completion_id: io_req.completion_id,
+                    io_control_code: r.io_control_code.0,
+                    output_buffer_length: r.output_buffer_length,
+                    input_buffer: Vec::new(),
+                };
+                (key, PendingDriveIrp::DeviceControl(io_req), payload)
+            }
+            ServerDriveIoRequest::ServerDriveNotifyChangeDirectoryRequest(r) => {
+                let io_req = r.device_io_request;
+                let key = (io_req.device_id, io_req.completion_id);
+                let payload = DriveRequestPayload::NotifyChangeDirectory {
+                    device_id: io_req.device_id,
+                    file_id: io_req.file_id,
+                    completion_id: io_req.completion_id,
+                    watch_tree: r.watch_tree != 0,
+                    completion_filter: r.completion_filter,
+                };
+                (key, PendingDriveIrp::NotifyChangeDirectory(io_req), payload)
+            }
+            ServerDriveIoRequest::ServerDriveQuerySecurityRequest(_)
+            | ServerDriveIoRequest::ServerDriveSetSecurityRequest(_) => {
+                unreachable!("security requests handled above")
+            }
+        };
+
+        if !self.send_to_loop(DriveBackendMessage::Request(payload)) {
+            return Ok(vec![pending.cancel_message()?]);
+        }
+
+        self.pending_irps.insert(key, pending);
+        Ok(Vec::new())
+    }
+
+    fn handle_printer_io_request(&mut self, req: PrinterIoRequest) -> PduResult<Vec<SvcMessage>> {
+        if let Some(printer) = self.printer.as_mut() {
+            return printer.handle_printer_io_request(req);
+        }
+        let device_io_request = req.into_device_io_request();
+        Ok(vec![SvcMessage::from(RdpdrPdu::DeviceCloseResponse(
+            DeviceCloseResponse {
+                device_io_response: DeviceIoResponse::new(device_io_request, NtStatus::NOT_SUPPORTED),
+            },
+        ))])
+    }
+
+    fn reject_printer_write(&mut self, req: DeviceIoRequest) -> PduResult<Vec<SvcMessage>> {
+        if let Some(printer) = self.printer.as_mut() {
+            return printer.reject_printer_write(req);
+        }
+        Ok(vec![SvcMessage::from(RdpdrPdu::DeviceWriteResponse(
+            DeviceWriteResponse {
+                device_io_reply: DeviceIoResponse::new(req, NtStatus::NOT_SUPPORTED),
+                length: 0,
+            },
+        ))])
+    }
+}

+/// Parses a single `{ deviceId: number, name: string }` descriptor for `rdpdr_add_drive`.
+pub(crate) fn parse_drive_descriptor(value: JsValue) -> Result<(u32, String), IronError> {
+    let obj = value
+        .dyn_into::<js_sys::Object>()
+        .map_err(|_| anyhow::anyhow!("drive descriptor must be an object"))?;
+    let device_id = prop_u32(&obj, "deviceId")?;
+    if device_id == 0 {
+        return Err(anyhow::anyhow!("drive deviceId must be non-zero").into());
+    }
+    let raw_name = prop_string(&obj, "name")?;
+    Ok((device_id, sanitize_drive_name(&raw_name)))
+}
+
+/// Parses a `deviceId` (either a bare number or `{ deviceId: number }`) for `rdpdr_remove_drive`.
+pub(crate) fn parse_drive_device_id(value: JsValue) -> Result<u32, IronError> {
+    if let Some(num) = value.as_f64() {
+        let id = f64_to_u32(num).context("invalid deviceId")?;
+        if id == 0 {
+            return Err(anyhow::anyhow!("drive deviceId must be non-zero").into());
+        }
+        return Ok(id);
+    }
+    let obj = value
+        .dyn_into::<js_sys::Object>()
+        .map_err(|_| anyhow::anyhow!("rdpdr_remove_drive expects a deviceId number or object"))?;
+    let id = prop_u32(&obj, "deviceId")?;
+    if id == 0 {
+        return Err(anyhow::anyhow!("drive deviceId must be non-zero").into());
+    }
+    Ok(id)
+}

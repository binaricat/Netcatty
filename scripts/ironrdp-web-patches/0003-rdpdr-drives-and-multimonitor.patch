+/// Converts a [`DriveBackendMessage`] into the plain JavaScript object passed to
+/// `rdpdr_request_callback`.
+pub(crate) fn drive_message_to_js(message: DriveBackendMessage) -> JsValue {
+    let obj = js_sys::Object::new();
+    let set = |key: &str, value: JsValue| {
+        let _ = js_sys::Reflect::set(&obj, &JsValue::from_str(key), &value);
+    };
+
+    match message {
+        DriveBackendMessage::Reset => {
+            set("op", JsValue::from_str("reset"));
+            set("deviceId", JsValue::from(0u32));
+            set("fileId", JsValue::from(0u32));
+            set("completionId", JsValue::from(0u32));
+        }
+        DriveBackendMessage::Request(req) => match req {
+            DriveRequestPayload::Create {
+                device_id,
+                file_id,
+                completion_id,
+                path,
+                desired_access,
+                allocation_size,
+                file_attributes,
+                shared_access,
+                create_disposition,
+                create_options,
+            } => {
+                set("op", JsValue::from_str("create"));
+                set("deviceId", JsValue::from(device_id));
+                set("fileId", JsValue::from(file_id));
+                set("completionId", JsValue::from(completion_id));
+                set("path", JsValue::from_str(&path));
+                set("desiredAccess", JsValue::from(desired_access));
+                set("allocationSize", u64_to_js_number(allocation_size));
+                set("fileAttributes", JsValue::from(file_attributes));
+                set("sharedAccess", JsValue::from(shared_access));
+                set("createDisposition", JsValue::from(create_disposition));
+                set("createOptions", JsValue::from(create_options));
+            }
+            DriveRequestPayload::Close {
+                device_id,
+                file_id,
+                completion_id,
+            } => {
+                set("op", JsValue::from_str("close"));
+                set("deviceId", JsValue::from(device_id));
+                set("fileId", JsValue::from(file_id));
+                set("completionId", JsValue::from(completion_id));
+            }
+            DriveRequestPayload::Read {
+                device_id,
+                file_id,
+                completion_id,
+                offset,
+                length,
+            } => {
+                set("op", JsValue::from_str("read"));
+                set("deviceId", JsValue::from(device_id));
+                set("fileId", JsValue::from(file_id));
+                set("completionId", JsValue::from(completion_id));
+                set("offset", u64_to_js_number(offset));
+                set("length", JsValue::from(length));
+            }
+            DriveRequestPayload::Write {
+                device_id,
+                file_id,
+                completion_id,
+                offset,
+                data,
+            } => {
+                set("op", JsValue::from_str("write"));
+                set("deviceId", JsValue::from(device_id));
+                set("fileId", JsValue::from(file_id));
+                set("completionId", JsValue::from(completion_id));
+                set("offset", u64_to_js_number(offset));
+                set("data", js_sys::Uint8Array::from(data.as_slice()).into());
+            }
+            DriveRequestPayload::QueryDirectory {
+                device_id,
+                file_id,
+                completion_id,
+                information_class,
+                initial_query,
+                path,
+            } => {
+                set("op", JsValue::from_str("query_directory"));
+                set("deviceId", JsValue::from(device_id));
+                set("fileId", JsValue::from(file_id));
+                set("completionId", JsValue::from(completion_id));
+                set("informationClass", JsValue::from(information_class));
+                set("initialQuery", JsValue::from_bool(initial_query));
+                set("path", JsValue::from_str(&path));
+            }
+            DriveRequestPayload::QueryInformation {
+                device_id,
+                file_id,
+                completion_id,
+                information_class,
+            } => {
+                set("op", JsValue::from_str("query_information"));
+                set("deviceId", JsValue::from(device_id));
+                set("fileId", JsValue::from(file_id));
+                set("completionId", JsValue::from(completion_id));
+                set("informationClass", JsValue::from(information_class));
+            }
+            DriveRequestPayload::QueryVolumeInformation {
+                device_id,
+                file_id,
+                completion_id,
+                information_class,
+            } => {
+                set("op", JsValue::from_str("query_volume_information"));
+                set("deviceId", JsValue::from(device_id));
+                set("fileId", JsValue::from(file_id));
+                set("completionId", JsValue::from(completion_id));
+                set("informationClass", JsValue::from(information_class));
+            }
+            DriveRequestPayload::SetInformation {
+                device_id,
+                file_id,
+                completion_id,
+                information_class,
+                data,
+            } => {
+                set("op", JsValue::from_str("set_information"));
+                set("deviceId", JsValue::from(device_id));
+                set("fileId", JsValue::from(file_id));
+                set("completionId", JsValue::from(completion_id));
+                set("informationClass", JsValue::from(information_class));
+                match data {
+                    SetInformationPayload::Basic {
+                        creation_time,
+                        last_access_time,
+                        last_write_time,
+                        change_time,
+                        file_attributes,
+                    } => {
+                        set("creationTime", JsValue::from_str(&creation_time.to_string()));
+                        set("lastAccessTime", JsValue::from_str(&last_access_time.to_string()));
+                        set("lastWriteTime", JsValue::from_str(&last_write_time.to_string()));
+                        set("changeTime", JsValue::from_str(&change_time.to_string()));
+                        set("fileAttributes", JsValue::from(file_attributes));
+                    }
+                    SetInformationPayload::Rename {
+                        replace_if_exists,
+                        rename_target,
+                    } => {
+                        set("replaceIfExists", JsValue::from_bool(replace_if_exists));
+                        set("renameTarget", JsValue::from_str(&rename_target));
+                    }
+                    SetInformationPayload::Disposition { delete_on_close } => {
+                        set("deleteOnClose", JsValue::from_bool(delete_on_close));
+                    }
+                    SetInformationPayload::Allocation { allocation_size } => {
+                        set("allocationSize", i64_to_js_number(allocation_size));
+                    }
+                    SetInformationPayload::EndOfFile { eof_size } => {
+                        set("eofSize", i64_to_js_number(eof_size));
+                    }
+                    SetInformationPayload::Other => {}
+                }
+            }
+            DriveRequestPayload::Flush {
+                device_id,
+                file_id,
+                completion_id,
+            } => {
+                set("op", JsValue::from_str("flush"));
+                set("deviceId", JsValue::from(device_id));
+                set("fileId", JsValue::from(file_id));
+                set("completionId", JsValue::from(completion_id));
+            }
+            DriveRequestPayload::LockControl {
+                device_id,
+                file_id,
+                completion_id,
+                operation,
+                wait,
+                locks,
+            } => {
+                set("op", JsValue::from_str("lock_control"));
+                set("deviceId", JsValue::from(device_id));
+                set("fileId", JsValue::from(file_id));
+                set("completionId", JsValue::from(completion_id));
+                set("operation", JsValue::from(operation));
+                set("wait", JsValue::from_bool(wait));
+                let js_locks = js_sys::Array::new();
+                for (offset, length) in locks {
+                    let lock_obj = js_sys::Object::new();
+                    let _ = js_sys::Reflect::set(&lock_obj, &JsValue::from_str("offset"), &u64_to_js_number(offset));
+                    let _ = js_sys::Reflect::set(&lock_obj, &JsValue::from_str("length"), &u64_to_js_number(length));
+                    js_locks.push(&lock_obj);
+                }
+                set("locks", js_locks.into());
+            }
+            DriveRequestPayload::DeviceControl {
+                device_id,
+                file_id,
+                completion_id,
+                io_control_code,
+                output_buffer_length,
+                input_buffer,
+            } => {
+                set("op", JsValue::from_str("device_control"));
+                set("deviceId", JsValue::from(device_id));
+                set("fileId", JsValue::from(file_id));
+                set("completionId", JsValue::from(completion_id));
+                set("ioControlCode", JsValue::from(io_control_code));
+                set("outputBufferLength", JsValue::from(output_buffer_length));
+                set("inputBuffer", js_sys::Uint8Array::from(input_buffer.as_slice()).into());
+            }
+            DriveRequestPayload::NotifyChangeDirectory {
+                device_id,
+                file_id,
+                completion_id,
+                watch_tree,
+                completion_filter,
+            } => {
+                set("op", JsValue::from_str("notify_change_directory"));
+                set("deviceId", JsValue::from(device_id));
+                set("fileId", JsValue::from(file_id));
+                set("completionId", JsValue::from(completion_id));
+                set("watchTree", JsValue::from_bool(watch_tree));
+                set("completionFilter", JsValue::from(completion_filter));
+            }
+        },
+    }
+
+    obj.into()
+}

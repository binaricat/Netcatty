+        let _ = rx.try_recv().unwrap();
+        let msg = backend
+            .complete_response(DriveResponse::Close {
+                device_id: 10,
+                completion_id: 103,
+                status: NtStatus::SUCCESS,
+            })
+            .unwrap()
+            .expect("close completion");
+        let encoded = msg.encode_unframed_pdu().unwrap();
+        assert_eq!(decode_completion_header(&encoded).4, 0);
+    }

+    fn build_display_control_monitor_layout_validates_and_normalizes() {
+        // Multi-monitor side-by-side with DPR scale factors and non-zero primary origin shifted to (0, 0).
+        let layout = build_display_control_monitor_layout(&[
+            MonitorLayoutSpec {
+                left: 100,
+                top: 50,
+                width: 1921, // odd width adjusted down to 1920
+                height: 1080,
+                is_primary: Some(true),
+                scale_factor: normalize_scale_factor_percent(1.5),
+                physical_width: Some(527),
+                physical_height: Some(296),
+            },
+            MonitorLayoutSpec {
+                left: 2020, // 100 + 1920 -> shifted to 1920
+                top: 50,
+                width: 1280,
+                height: 1024,
+                is_primary: Some(false),
+                scale_factor: normalize_scale_factor_percent(200.0),
+                physical_width: None,
+                physical_height: None,
+            },
+        ])
+        .expect("valid dual-monitor layout");
+
+        assert_eq!(layout.monitors().len(), 2);
+        assert!(layout.monitors()[0].is_primary());
+        assert_eq!(layout.monitors()[0].position(), Some((0, 0)));
+        assert_eq!(layout.monitors()[0].dimensions(), (1920, 1080));
+        assert_eq!(layout.monitors()[0].desktop_scale_factor(), Some(150));
+        assert_eq!(layout.monitors()[0].physical_dimensions(), Some((527, 296)));
+
+        assert!(!layout.monitors()[1].is_primary());
+        assert_eq!(layout.monitors()[1].position(), Some((1920, 0)));
+        assert_eq!(layout.monitors()[1].dimensions(), (1280, 1024));
+        assert_eq!(layout.monitors()[1].desktop_scale_factor(), Some(200));
+
+        // Rejects empty list

+
+        // 1. Create
+        let create_req = DeviceCreateRequest {
+            device_io_request: make_io_req(10, 0, 100, MajorFunction::Create),
+            desired_access: DesiredAccess::GENERIC_READ,
+            allocation_size: 0,
+            file_attributes: FileAttributes::FILE_ATTRIBUTE_NORMAL,
+            shared_access: SharedAccess::FILE_SHARE_READ,
+            create_disposition: CreateDisposition::FILE_OPEN,
+            create_options: CreateOptions::empty(),
+            path: "\\hello.txt".to_owned(),
+        };
+        let immediate = backend
+            .handle_drive_io_request(ServerDriveIoRequest::ServerCreateDriveRequest(create_req))
+            .unwrap();
+        assert!(immediate.is_empty(), "drive IRPs complete asynchronously");
+
+        match rx.try_recv().unwrap() {
+            RdpInputEvent::DriveRequest(DriveBackendMessage::Request(DriveRequestPayload::Create {
+                device_id,
+                completion_id,
+                path,
+                ..
+            })) => {
+                assert_eq!(device_id, 10);
+                assert_eq!(completion_id, 100);
+                assert_eq!(path, "\\hello.txt");
+            }
+            other => panic!("unexpected event: {other:?}"),
+        }
+
+        let msg = backend
+            .complete_response(DriveResponse::Create {
+                device_id: 10,
+                completion_id: 100,
+                status: NtStatus::SUCCESS,
+                file_id: 7,
+                information: Information::FILE_OPENED,
+            })
+            .unwrap()
+            .expect("completion emitted");
+        let encoded = msg.encode_unframed_pdu().unwrap();
+        let (comp, pkt, dev, cid, st) = decode_completion_header(&encoded);
+        assert_eq!(comp, 0x4472);
+        assert_eq!(pkt, 0x4943);
+        assert_eq!((dev, cid, st), (10, 100, 0));
+        assert_eq!(u32::from_le_bytes(encoded[16..20].try_into().unwrap()), 7);
+        assert_eq!(encoded[20], Information::FILE_OPENED.bits());
+
+        // 2. Read
+        let read_req = DeviceReadRequest {
+            device_io_request: make_io_req(10, 7, 101, MajorFunction::Read),
+            length: 16,
+            offset: 4,
+        };
+        backend
+            .handle_drive_io_request(ServerDriveIoRequest::DeviceReadRequest(read_req))
+            .unwrap();
+        let _ = rx.try_recv().unwrap();
+
+        let msg = backend
+            .complete_response(DriveResponse::Read {
+                device_id: 10,
+                completion_id: 101,
+                status: NtStatus::SUCCESS,
+                data: b"world".to_vec(),
+            })
+            .unwrap()
+            .expect("read completion");
+        let encoded = msg.encode_unframed_pdu().unwrap();
+        let mut cursor = ReadCursor::new(&encoded[16..]);
+        let decoded = DeviceReadResponse::decode(
+            DeviceIoResponse {
+                device_id: 10,
+                completion_id: 101,
+                io_status: NtStatus::SUCCESS,
+            },
+            &mut cursor,
+        )
+        .unwrap();
+        assert_eq!(decoded.read_data, b"world");
+
+        // 3. Write (read-only rejection -> MEDIA_WRITE_PROTECTED)
+        let write_req = DeviceWriteRequest {
+            device_io_request: make_io_req(10, 7, 102, MajorFunction::Write),
+            offset: 0,
+            write_data: b"abc".to_vec(),
+        };
+        backend
+            .handle_drive_io_request(ServerDriveIoRequest::DeviceWriteRequest(write_req))
+            .unwrap();
+        let _ = rx.try_recv().unwrap();
+
+        let msg = backend
+            .complete_response(DriveResponse::Write {
+                device_id: 10,
+                completion_id: 102,
+                status: NtStatus::from(0xC000_00A2),
+                bytes_written: 3,
+            })
+            .unwrap()
+            .expect("write completion");
+        let encoded = msg.encode_unframed_pdu().unwrap();
+        let (_, _, _, _, st) = decode_completion_header(&encoded);
+        assert_eq!(st, 0xC000_00A2);
+        assert_eq!(
+            u32::from_le_bytes(encoded[16..20].try_into().unwrap()),
+            0,
+            "failed write must report 0 bytes written"
+        );
+
+        // 4. Close
+        let close_req = DeviceCloseRequest {
+            device_io_request: make_io_req(10, 7, 103, MajorFunction::Close),
+        };
+        backend
+            .handle_drive_io_request(ServerDriveIoRequest::DeviceCloseRequest(close_req))

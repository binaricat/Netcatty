+fn build_volume_info_class(info: DriveVolumeInfo) -> FileSystemInformationClass {
+    match info {
+        DriveVolumeInfo::Volume {
+            creation_time,
+            serial_number,
+            supports_objects,
+            label,
+        } => FileSystemInformationClass::FileFsVolumeInformation(
+            ironrdp::rdpdr::pdu::efs::FileFsVolumeInformation {
+                volume_creation_time: creation_time,
+                volume_serial_number: serial_number,
+                supports_objects: if supports_objects {
+                    Boolean::True
+                } else {
+                    Boolean::False
+                },
+                volume_label: label,
+            },
+        ),
+        DriveVolumeInfo::Size {
+            total_alloc_units,
+            available_alloc_units,
+            sectors_per_alloc_unit,
+            bytes_per_sector,
+        } => FileSystemInformationClass::FileFsSizeInformation(ironrdp::rdpdr::pdu::efs::FileFsSizeInformation {
+            total_alloc_units,
+            available_alloc_units,
+            sectors_per_alloc_unit,
+            bytes_per_sector,
+        }),
+        DriveVolumeInfo::Device {
+            device_type,
+            characteristics,
+        } => FileSystemInformationClass::FileFsDeviceInformation(ironrdp::rdpdr::pdu::efs::FileFsDeviceInformation {
+            device_type,
+            characteristics: Characteristics::from_bits_retain(characteristics),
+        }),
+        DriveVolumeInfo::Attribute {
+            attributes,
+            max_component_name_len,
+            file_system_name,
+        } => FileSystemInformationClass::FileFsAttributeInformation(
+            ironrdp::rdpdr::pdu::efs::FileFsAttributeInformation {
+                file_system_attributes: FileSystemAttributes::from_bits_retain(attributes),
+                max_component_name_len,
+                file_system_name,
+            },
+        ),
+        DriveVolumeInfo::FullSize {
+            total_alloc_units,
+            caller_available_alloc_units,
+            actual_available_alloc_units,
+            sectors_per_alloc_unit,
+            bytes_per_sector,
+        } => FileSystemInformationClass::FileFsFullSizeInformation(
+            ironrdp::rdpdr::pdu::efs::FileFsFullSizeInformation {
+                total_alloc_units,
+                caller_available_alloc_units,
+                actual_available_alloc_units,
+                sectors_per_alloc_unit,
+                bytes_per_sector,
+            },
+        ),
+    }
+}

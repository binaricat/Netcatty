+/// Parses the JS response object passed to `Session.invokeExtension("rdpdr_response", resp)`.
+pub(crate) fn parse_drive_response(value: JsValue) -> Result<DriveResponse, IronError> {
+    let obj = value
+        .dyn_into::<js_sys::Object>()
+        .map_err(|_| anyhow::anyhow!("rdpdr_response expects an object"))?;
+    let op = prop_string(&obj, "op")?;
+    if op == "reset" {
+        return Ok(DriveResponse::Reset);
+    }
+
+    let device_id = prop_u32(&obj, "deviceId")?;
+    let completion_id = prop_u32(&obj, "completionId")?;
+    let status = NtStatus::from(prop_u32(&obj, "status")?);
+
+    match op.as_str() {
+        "create" => {
+            let file_id = prop_u32_opt(&obj, "fileId")?.unwrap_or(0);
+            let default_info = if status == NtStatus::SUCCESS {
+                Information::FILE_OPENED.bits()
+            } else {
+                0
+            };
+            let info_u8 = prop_u32_opt(&obj, "information")?
+                .and_then(|v| u8::try_from(v).ok())
+                .unwrap_or(default_info);
+            Ok(DriveResponse::Create {
+                device_id,
+                completion_id,
+                status,
+                file_id,
+                information: Information::from_bits_retain(info_u8),
+            })
+        }
+        "close" => Ok(DriveResponse::Close {
+            device_id,
+            completion_id,
+            status,
+        }),
+        "read" => {
+            let data = if status == NtStatus::SUCCESS {
+                prop_bytes_opt(&obj, "data")?
+            } else {
+                Vec::new()
+            };
+            Ok(DriveResponse::Read {
+                device_id,
+                completion_id,
+                status,
+                data,
+            })
+        }
+        "write" => {
+            let bytes_written = match prop_u32_opt(&obj, "bytesWritten")? {
+                Some(n) => n,
+                None => prop_u32_opt(&obj, "length")?.unwrap_or(0),
+            };
+            Ok(DriveResponse::Write {
+                device_id,
+                completion_id,
+                status,
+                bytes_written,
+            })
+        }
+        "query_directory" => {
+            let information_class = prop_u32_opt(&obj, "informationClass")?;
+            let entry = if status == NtStatus::SUCCESS {
+                prop_object_opt(&obj, "entry")?
+                    .map(|entry_obj| parse_directory_entry(&entry_obj))
+                    .transpose()?
+            } else {
+                None
+            };
+            Ok(DriveResponse::QueryDirectory {
+                device_id,
+                completion_id,
+                status,
+                information_class,
+                entry,
+            })
+        }
+        "query_information" => {
+            let information_class = prop_u32_opt(&obj, "informationClass")?;
+            let info = if status == NtStatus::SUCCESS {
+                parse_query_info(&obj, information_class)?
+            } else {
+                None
+            };
+            Ok(DriveResponse::QueryInformation {
+                device_id,
+                completion_id,
+                status,
+                info,
+            })
+        }
+        "query_volume_information" => {
+            let information_class = prop_u32_opt(&obj, "informationClass")?;
+            let info = if status == NtStatus::SUCCESS {
+                parse_query_volume_info(&obj, information_class)?
+            } else {
+                None
+            };
+            Ok(DriveResponse::QueryVolumeInformation {
+                device_id,
+                completion_id,
+                status,
+                info,
+            })
+        }
+        "set_information" => Ok(DriveResponse::SetInformation {
+            device_id,
+            completion_id,
+            status,
+        }),
+        "flush" => Ok(DriveResponse::Flush {
+            device_id,
+            completion_id,
+            status,
+        }),
+        "lock_control" => Ok(DriveResponse::LockControl {
+            device_id,
+            completion_id,
+            status,
+        }),
+        "device_control" => {
+            let output_buffer = if status == NtStatus::SUCCESS {
+                prop_bytes_opt(&obj, "outputBuffer")?
+            } else {
+                Vec::new()
+            };
+            Ok(DriveResponse::DeviceControl {
+                device_id,
+                completion_id,
+                status,
+                output_buffer,
+            })
+        }
+        "notify_change_directory" => {
+            let buffer = if status == NtStatus::SUCCESS {
+                prop_bytes_opt(&obj, "buffer")?
+            } else {
+                Vec::new()
+            };
+            Ok(DriveResponse::NotifyChangeDirectory {
+                device_id,
+                completion_id,
+                status,
+                buffer,
+            })
+        }
+        other => Err(anyhow::anyhow!("unknown rdpdr_response op `{other}`").into()),
+    }
+}
+
+fn parse_directory_entry(obj: &js_sys::Object) -> Result<DriveDirectoryEntry, IronError> {
+    let file_name = match prop_string_opt(obj, "fileName")? {
+        Some(name) => name,
+        None => prop_string(obj, "name")?,
+    };
+    let creation_time = prop_i64_flexible_opt(obj, "creationTime")?.unwrap_or(0);
+    let last_access_time = prop_i64_flexible_opt(obj, "lastAccessTime")?.unwrap_or(0);
+    let last_write_time = prop_i64_flexible_opt(obj, "lastWriteTime")?.unwrap_or(0);
+    let change_time = prop_i64_flexible_opt(obj, "changeTime")?.unwrap_or(last_write_time);
+    let end_of_file = match prop_i64_flexible_opt(obj, "endOfFile")? {
+        Some(size) => size,
+        None => prop_i64_flexible_opt(obj, "size")?.unwrap_or(0),
+    };
+    let allocation_size = prop_i64_flexible_opt(obj, "allocationSize")?.unwrap_or(end_of_file);
+    let file_attributes = prop_u32_opt(obj, "fileAttributes")?.unwrap_or(0);
+
+    Ok(DriveDirectoryEntry {
+        file_name,
+        creation_time,
+        last_access_time,
+        last_write_time,
+        change_time,
+        end_of_file,
+        allocation_size,
+        file_attributes,
+    })
+}
+
+fn parse_query_info(obj: &js_sys::Object, info_class: Option<u32>) -> Result<Option<DriveFileInfo>, IronError> {
+    if let Some(basic_obj) = prop_object_opt(obj, "basic")? {
+        return Ok(Some(parse_basic_info(&basic_obj)?));
+    }
+    if let Some(standard_obj) = prop_object_opt(obj, "standard")? {
+        return Ok(Some(parse_standard_info(&standard_obj)?));
+    }
+    if let Some(attr_obj) = prop_object_opt(obj, "attributeTag")? {
+        return Ok(Some(parse_attribute_tag_info(&attr_obj)?));
+    }
+
+    // Fallback: accept generic `info` property keyed by `informationClass`.
+    if let Some(info_obj) = prop_object_opt(obj, "info")? {
+        let class = info_class.map(FileInformationClassLevel::from);
+        if class == Some(FileInformationClassLevel::FILE_BASIC_INFORMATION) {
+            return Ok(Some(parse_basic_info(&info_obj)?));
+        }
+        if class == Some(FileInformationClassLevel::FILE_STANDARD_INFORMATION) {
+            return Ok(Some(parse_standard_info(&info_obj)?));
+        }
+        if class == Some(FileInformationClassLevel::FILE_ATTRIBUTE_TAG_INFORMATION) {
+            return Ok(Some(parse_attribute_tag_info(&info_obj)?));
+        }
+    }
+
+    Ok(None)
+}
+
+fn parse_basic_info(obj: &js_sys::Object) -> Result<DriveFileInfo, IronError> {
+    Ok(DriveFileInfo::Basic(FileBasicInformation {
+        creation_time: prop_i64_flexible_opt(obj, "creationTime")?.unwrap_or(0),
+        last_access_time: prop_i64_flexible_opt(obj, "lastAccessTime")?.unwrap_or(0),
+        last_write_time: prop_i64_flexible_opt(obj, "lastWriteTime")?.unwrap_or(0),
+        change_time: prop_i64_flexible_opt(obj, "changeTime")?.unwrap_or(0),
+        file_attributes: FileAttributes::from_bits_retain(prop_u32_opt(obj, "fileAttributes")?.unwrap_or(0)),
+    }))
+}
+
+fn parse_standard_info(obj: &js_sys::Object) -> Result<DriveFileInfo, IronError> {
+    let end_of_file = prop_i64_flexible_opt(obj, "endOfFile")?.unwrap_or(0);
+    let allocation_size = prop_i64_flexible_opt(obj, "allocationSize")?.unwrap_or(end_of_file);
+    let number_of_links = prop_u32_opt(obj, "numberOfLinks")?.unwrap_or(1);
+    let delete_pending = prop_bool_opt(obj, "deletePending")?.unwrap_or(false);
+    let directory = match prop_bool_opt(obj, "directory")? {
+        Some(flag) => flag,
+        None => prop_bool_opt(obj, "isDirectory")?.unwrap_or(false),
+    };
+    Ok(DriveFileInfo::Standard(FileStandardInformation {
+        allocation_size,
+        end_of_file,
+        number_of_links,
+        delete_pending: if delete_pending { Boolean::True } else { Boolean::False },
+        directory: if directory { Boolean::True } else { Boolean::False },
+    }))
+}
+
+fn parse_attribute_tag_info(obj: &js_sys::Object) -> Result<DriveFileInfo, IronError> {
+    Ok(DriveFileInfo::AttributeTag(FileAttributeTagInformation {
+        file_attributes: FileAttributes::from_bits_retain(prop_u32_opt(obj, "fileAttributes")?.unwrap_or(0)),
+        reparse_tag: prop_u32_opt(obj, "reparseTag")?.unwrap_or(0),
+    }))
+}
+
+fn parse_query_volume_info(obj: &js_sys::Object, info_class: Option<u32>) -> Result<Option<DriveVolumeInfo>, IronError> {
+    if let Some(vol_obj) = prop_object_opt(obj, "volume")? {
+        return Ok(Some(parse_fs_volume_info(&vol_obj)?));
+    }
+    if let Some(size_obj) = prop_object_opt(obj, "size")? {
+        return Ok(Some(parse_fs_size_info(&size_obj)?));
+    }
+    if let Some(dev_obj) = prop_object_opt(obj, "device")? {
+        return Ok(Some(parse_fs_device_info(&dev_obj)?));
+    }
+    if let Some(attr_obj) = prop_object_opt(obj, "attribute")? {
+        return Ok(Some(parse_fs_attribute_info(&attr_obj)?));
+    }
+    if let Some(full_obj) = prop_object_opt(obj, "fullSize")? {
+        return Ok(Some(parse_fs_full_size_info(&full_obj)?));
+    }
+
+    // Fallback: accept generic `info` property keyed by `informationClass`.
+    if let Some(info_obj) = prop_object_opt(obj, "info")? {
+        let class = info_class.map(FileSystemInformationClassLevel::from);
+        if class == Some(FileSystemInformationClassLevel::FILE_FS_VOLUME_INFORMATION) {
+            return Ok(Some(parse_fs_volume_info(&info_obj)?));
+        }
+        if class == Some(FileSystemInformationClassLevel::FILE_FS_SIZE_INFORMATION) {
+            return Ok(Some(parse_fs_size_info(&info_obj)?));
+        }
+        if class == Some(FileSystemInformationClassLevel::FILE_FS_DEVICE_INFORMATION) {
+            return Ok(Some(parse_fs_device_info(&info_obj)?));
+        }
+        if class == Some(FileSystemInformationClassLevel::FILE_FS_ATTRIBUTE_INFORMATION) {
+            return Ok(Some(parse_fs_attribute_info(&info_obj)?));
+        }
+        if class == Some(FileSystemInformationClassLevel::FILE_FS_FULL_SIZE_INFORMATION) {
+            return Ok(Some(parse_fs_full_size_info(&info_obj)?));
+        }
+    }
+
+    Ok(None)
+}
+
+fn parse_fs_volume_info(obj: &js_sys::Object) -> Result<DriveVolumeInfo, IronError> {
+    let creation_time = match prop_i64_flexible_opt(obj, "creationTime")? {
+        Some(t) => t,
+        None => prop_i64_flexible_opt(obj, "volumeCreationTime")?.unwrap_or(0),
+    };
+    let serial_number = match prop_u32_opt(obj, "serialNumber")? {
+        Some(n) => n,
+        None => prop_u32_opt(obj, "volumeSerialNumber")?.unwrap_or(0),
+    };
+    let supports_objects = prop_bool_opt(obj, "supportsObjects")?.unwrap_or(false);
+    let label = match prop_string_opt(obj, "label")? {
+        Some(s) => s,
+        None => prop_string_opt(obj, "volumeLabel")?.unwrap_or_else(|| "NETCATTY".to_owned()),
+    };
+    Ok(DriveVolumeInfo::Volume {
+        creation_time,
+        serial_number,
+        supports_objects,
+        label,
+    })
+}
+
+fn parse_fs_size_info(obj: &js_sys::Object) -> Result<DriveVolumeInfo, IronError> {
+    let total_alloc_units = match prop_i64_flexible_opt(obj, "totalAllocationUnits")? {
+        Some(n) => n,
+        None => prop_i64_flexible_opt(obj, "totalAllocUnits")?.unwrap_or(0),
+    };
+    let available_alloc_units = match prop_i64_flexible_opt(obj, "availableAllocationUnits")? {
+        Some(n) => n,
+        None => prop_i64_flexible_opt(obj, "availableAllocUnits")?.unwrap_or(0),
+    };
+    let sectors_per_alloc_unit = match prop_u32_opt(obj, "sectorsPerAllocationUnit")? {
+        Some(n) => n,
+        None => prop_u32_opt(obj, "sectorsPerAllocUnit")?.unwrap_or(1),
+    };
+    let bytes_per_sector = prop_u32_opt(obj, "bytesPerSector")?.unwrap_or(512);
+    Ok(DriveVolumeInfo::Size {
+        total_alloc_units,
+        available_alloc_units,
+        sectors_per_alloc_unit,
+        bytes_per_sector,
+    })
+}
+
+fn parse_fs_device_info(obj: &js_sys::Object) -> Result<DriveVolumeInfo, IronError> {
+    Ok(DriveVolumeInfo::Device {
+        device_type: prop_u32_opt(obj, "deviceType")?.unwrap_or(0x0000_0007),
+        characteristics: prop_u32_opt(obj, "characteristics")?.unwrap_or(0),
+    })
+}
+
+fn parse_fs_attribute_info(obj: &js_sys::Object) -> Result<DriveVolumeInfo, IronError> {
+    let attributes = match prop_u32_opt(obj, "attributes")? {
+        Some(n) => n,
+        None => prop_u32_opt(obj, "fileSystemAttributes")?.unwrap_or(
+            (FileSystemAttributes::FILE_CASE_PRESERVED_NAMES | FileSystemAttributes::FILE_UNICODE_ON_DISK).bits(),
+        ),
+    };
+    let max_component_name_len = prop_u32_opt(obj, "maxComponentNameLen")?.unwrap_or(255);
+    let file_system_name = prop_string_opt(obj, "fileSystemName")?.unwrap_or_else(|| "FAT32".to_owned());
+    Ok(DriveVolumeInfo::Attribute {
+        attributes,
+        max_component_name_len,
+        file_system_name,
+    })
+}
+
+fn parse_fs_full_size_info(obj: &js_sys::Object) -> Result<DriveVolumeInfo, IronError> {
+    let total_alloc_units = match prop_i64_flexible_opt(obj, "totalAllocationUnits")? {
+        Some(n) => n,
+        None => prop_i64_flexible_opt(obj, "totalAllocUnits")?.unwrap_or(0),
+    };
+    let caller_available_alloc_units = match prop_i64_flexible_opt(obj, "callerAvailableAllocationUnits")? {
+        Some(n) => n,
+        None => prop_i64_flexible_opt(obj, "callerAvailableAllocUnits")?.unwrap_or(0),
+    };
+    let actual_available_alloc_units = match prop_i64_flexible_opt(obj, "actualAvailableAllocationUnits")? {
+        Some(n) => n,
+        None => prop_i64_flexible_opt(obj, "actualAvailableAllocUnits")?.unwrap_or(caller_available_alloc_units),
+    };
+    let sectors_per_alloc_unit = match prop_u32_opt(obj, "sectorsPerAllocationUnit")? {
+        Some(n) => n,
+        None => prop_u32_opt(obj, "sectorsPerAllocUnit")?.unwrap_or(1),
+    };
+    let bytes_per_sector = prop_u32_opt(obj, "bytesPerSector")?.unwrap_or(512);
+    Ok(DriveVolumeInfo::FullSize {
+        total_alloc_units,
+        caller_available_alloc_units,
+        actual_available_alloc_units,
+        sectors_per_alloc_unit,
+        bytes_per_sector,
+    })
+}
+
+// ---- JS reflection helpers ----
+
+fn prop_raw(obj: &js_sys::Object, key: &str) -> Result<JsValue, IronError> {
+    js_sys::Reflect::get(obj, &JsValue::from_str(key))
+        .map_err(|e| anyhow::anyhow!("get property `{key}`: {e:?}").into())
+}
+
+fn prop_string(obj: &js_sys::Object, key: &str) -> Result<String, IronError> {
+    prop_string_opt(obj, key)?.ok_or_else(|| anyhow::anyhow!("missing string property `{key}`").into())
+}
+
+fn prop_string_opt(obj: &js_sys::Object, key: &str) -> Result<Option<String>, IronError> {
+    let val = prop_raw(obj, key)?;
+    if val.is_undefined() || val.is_null() {
+        return Ok(None);
+    }
+    val.as_string()
+        .map(Some)
+        .ok_or_else(|| anyhow::anyhow!("property `{key}` must be a string").into())
+}
+
+fn prop_u32(obj: &js_sys::Object, key: &str) -> Result<u32, IronError> {
+    prop_u32_opt(obj, key)?.ok_or_else(|| anyhow::anyhow!("missing number property `{key}`").into())
+}
+
+fn prop_u32_opt(obj: &js_sys::Object, key: &str) -> Result<Option<u32>, IronError> {
+    let val = prop_raw(obj, key)?;
+    if val.is_undefined() || val.is_null() {
+        return Ok(None);
+    }
+    let f = val
+        .as_f64()
+        .ok_or_else(|| anyhow::anyhow!("property `{key}` must be a number"))?;
+    let v = f64_to_u32(f).with_context(|| format!("invalid u32 value for `{key}`"))?;
+    Ok(Some(v))
+}
+
+fn prop_bool_opt(obj: &js_sys::Object, key: &str) -> Result<Option<bool>, IronError> {
+    let val = prop_raw(obj, key)?;
+    if val.is_undefined() || val.is_null() {
+        return Ok(None);
+    }
+    val.as_bool()
+        .map(Some)
+        .ok_or_else(|| anyhow::anyhow!("property `{key}` must be a boolean").into())
+}
+
+fn prop_object_opt(obj: &js_sys::Object, key: &str) -> Result<Option<js_sys::Object>, IronError> {
+    let val = prop_raw(obj, key)?;
+    if val.is_undefined() || val.is_null() {
+        return Ok(None);
+    }
+    val.dyn_into::<js_sys::Object>()
+        .map(Some)
+        .map_err(|_| anyhow::anyhow!("property `{key}` must be an object").into())
+}
+
+fn prop_bytes_opt(obj: &js_sys::Object, key: &str) -> Result<Vec<u8>, IronError> {
+    let val = prop_raw(obj, key)?;
+    if val.is_undefined() || val.is_null() {
+        return Ok(Vec::new());
+    }
+    if let Ok(arr) = val.clone().dyn_into::<js_sys::Uint8Array>() {
+        return Ok(arr.to_vec());
+    }
+    if let Ok(buf) = val.clone().dyn_into::<js_sys::ArrayBuffer>() {
+        return Ok(js_sys::Uint8Array::new(&buf).to_vec());
+    }
+    if js_sys::Array::is_array(&val) {
+        return Ok(js_sys::Uint8Array::new(&val).to_vec());
+    }
+    Err(anyhow::anyhow!("property `{key}` must be a Uint8Array, ArrayBuffer, or byte array").into())
+}
+
+fn prop_i64_flexible_opt(obj: &js_sys::Object, key: &str) -> Result<Option<i64>, IronError> {
+    let val = prop_raw(obj, key)?;
+    if val.is_undefined() || val.is_null() {
+        return Ok(None);
+    }
+    if let Some(text) = val.as_string() {
+        let parsed = text
+            .trim()
+            .parse::<i64>()
+            .with_context(|| format!("invalid i64 string for `{key}`"))?;
+        return Ok(Some(parsed));
+    }
+    if let Some(num) = val.as_f64() {
+        if !num.is_finite() {
+            return Err(anyhow::anyhow!("property `{key}` must be finite").into());
+        }
+        #[expect(
+            clippy::as_conversions,
+            clippy::cast_possible_truncation,
+            clippy::cast_precision_loss,
+            reason = "clamped to finite i64 range before conversion"
+        )]
+        let clamped = num.clamp(i64::MIN as f64, i64::MAX as f64) as i64;
+        return Ok(Some(clamped));
+    }
+    if val.is_bigint() {
+        let bigint = js_sys::BigInt::from(val);
+        let text = bigint
+            .to_string(10)
+            .map_err(|e| anyhow::anyhow!("format bigint `{key}`: {e:?}"))?
+            .as_string()
+            .ok_or_else(|| anyhow::anyhow!("bigint `{key}` to_string returned non-string"))?;
+        let parsed = text
+            .parse::<i64>()
+            .with_context(|| format!("bigint `{key}` out of i64 range"))?;
+        return Ok(Some(parsed));
+    }
+    Err(anyhow::anyhow!("property `{key}` must be a string, number, or bigint").into())
+}
+
+fn f64_to_u32(val: f64) -> anyhow::Result<u32> {
+    if !val.is_finite() || val < 0.0 || val > f64::from(u32::MAX) || val.fract() != 0.0 {
+        anyhow::bail!("expected u32 integer, got {val}");
+    }
+    #[expect(
+        clippy::as_conversions,
+        clippy::cast_possible_truncation,
+        clippy::cast_sign_loss,
+        reason = "validated as finite integral value within 0..=u32::MAX"
+    )]
+    Ok(val as u32)
+}
+
+fn u64_to_js_number(val: u64) -> JsValue {
+    #[expect(
+        clippy::as_conversions,
+        clippy::cast_precision_loss,
+        reason = "JS number representation for file offsets/sizes"
+    )]
+    JsValue::from_f64(val as f64)
+}
+
+fn i64_to_js_number(val: i64) -> JsValue {
+    #[expect(
+        clippy::as_conversions,
+        clippy::cast_precision_loss,
+        reason = "JS number representation for file sizes"
+    )]
+    JsValue::from_f64(val as f64)
+}

+fn build_directory_info_class(
+    class: &FileInformationClassLevel,
+    entry: DriveDirectoryEntry,
+) -> Option<FileInformationClass> {
+    let attrs = FileAttributes::from_bits_retain(entry.file_attributes);
+    if *class == FileInformationClassLevel::FILE_BOTH_DIRECTORY_INFORMATION {
+        let mut info = FileBothDirectoryInformation::new(
+            entry.creation_time,
+            entry.last_access_time,
+            entry.last_write_time,
+            entry.change_time,
+            entry.end_of_file,
+            attrs,
+            entry.file_name,
+        );
+        info.allocation_size = entry.allocation_size;
+        Some(FileInformationClass::BothDirectory(info))
+    } else if *class == FileInformationClassLevel::FILE_FULL_DIRECTORY_INFORMATION {
+        let mut info = FileFullDirectoryInformation::new(
+            entry.creation_time,
+            entry.last_access_time,
+            entry.last_write_time,
+            entry.change_time,
+            entry.end_of_file,
+            attrs,
+            entry.file_name,
+        );
+        info.allocation_size = entry.allocation_size;
+        Some(FileInformationClass::FullDirectory(info))
+    } else if *class == FileInformationClassLevel::FILE_DIRECTORY_INFORMATION {
+        let mut info = FileDirectoryInformation::new(
+            entry.creation_time,
+            entry.last_access_time,
+            entry.last_write_time,
+            entry.change_time,
+            entry.end_of_file,
+            attrs,
+            entry.file_name,
+        );
+        info.allocation_size = entry.allocation_size;
+        Some(FileInformationClass::Directory(info))
+    } else if *class == FileInformationClassLevel::FILE_NAMES_INFORMATION {
+        Some(FileInformationClass::Names(FileNamesInformation::new(entry.file_name)))
+    } else {
+        None
+    }
+}

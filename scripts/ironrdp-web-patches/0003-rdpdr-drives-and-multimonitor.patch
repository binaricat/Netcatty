+/// `STATUS_CANCELLED` (`0xC0000120`), used when cancelling in-flight IRPs on drive removal.
+fn status_cancelled() -> NtStatus {
+    NtStatus::from(0xC000_0120)
+}
+
+/// Maximum UTF-8 byte length for a sanitized RDPDR drive share name.
+const MAX_DRIVE_NAME_BYTES: usize = 64;
+
+/// Sanitizes a drive share name for MS-RDPEFS announcement (`\\tsclient\<name>`).
+///
+/// Strips control characters and NULs, replaces characters forbidden in Windows
+/// share names (`< > " / \ | : ? *`), trims surrounding whitespace and trailing
+/// dots, truncates to [`MAX_DRIVE_NAME_BYTES`] on a UTF-8 boundary, and falls
+/// back to `"Share"` if empty.
+pub(crate) fn sanitize_drive_name(raw: &str) -> String {
+    let mut cleaned = String::with_capacity(raw.len().min(MAX_DRIVE_NAME_BYTES));
+    for ch in raw.trim().chars() {
+        if ch == '\0' || ch.is_control() {
+            continue;
+        }
+        let mapped = match ch {
+            '<' | '>' | '"' | '/' | '\\' | '|' | ':' | '?' | '*' => '_',
+            other => other,
+        };
+        if cleaned.len().saturating_add(mapped.len_utf8()) > MAX_DRIVE_NAME_BYTES {
+            break;
+        }
+        cleaned.push(mapped);
+    }
+    let trimmed = cleaned.trim_end_matches([' ', '.']);
+    if trimmed.is_empty() {
+        "Share".to_owned()
+    } else {
+        trimmed.to_owned()
+    }
+}

+/// Parses `rdpdr_drives` JS array (`Array<{ deviceId: number, name: string }>`).
+pub(crate) fn parse_drives_array(value: JsValue) -> Result<Vec<(u32, String)>, IronError> {
+    if value.is_null() || value.is_undefined() {
+        return Ok(Vec::new());
+    }
+    if !js_sys::Array::is_array(&value) {
+        return Err(anyhow::anyhow!("rdpdr_drives must be an array").into());
+    }
+    let arr = js_sys::Array::from(&value);
+    let mut seen_ids = HashSet::new();
+    let mut drives = Vec::new();
+    for idx in 0..arr.length() {
+        let item = arr.get(idx);
+        let (device_id, name) = parse_drive_descriptor(item)?;
+        if device_id == 0 {
+            return Err(anyhow::anyhow!("rdpdr drive deviceId must be non-zero").into());
+        }
+        if !seen_ids.insert(device_id) {
+            return Err(anyhow::anyhow!("duplicate rdpdr drive deviceId {device_id}").into());
+        }
+        drives.push((device_id, name));
+    }
+    Ok(drives)
+}

+        };
+
+        let (tx, mut rx) = mpsc::unbounded();
+        let printer = WasmPrinterBackend::new(WasmPrinterMessageProxy::new(tx.clone()));
+        let mut backend = WasmDriveBackend::new(tx).with_printer(printer);
+
+        // Printer create delegates to WasmPrinterBackend synchronously
+        let printer_create = DeviceCreateRequest {
+            device_io_request: make_io_req(2, 0, 1, MajorFunction::Create),
+            desired_access: DesiredAccess::empty(),
+            allocation_size: 0,
+            file_attributes: FileAttributes::empty(),
+            shared_access: SharedAccess::empty(),
+            create_disposition: CreateDisposition::FILE_OPEN,
+            create_options: CreateOptions::empty(),
+            path: String::new(),
+        };
+        let printer_resp = backend
+            .handle_printer_io_request(PrinterIoRequest::Create(printer_create))
+            .unwrap();
+        assert_eq!(printer_resp.len(), 1);
+        assert!(matches!(
+            rx.try_recv().unwrap(),
+            RdpInputEvent::Printer(PrinterBackendMessage::Created { .. })
+        ));
+
+        // Drive device_control with input/output buffers
+        let dc_req = DecodedDeviceControlRequest {
+            request: DeviceControlRequest {
+                header: make_io_req(10, 1, 600, MajorFunction::DeviceControl),
+                output_buffer_length: 64,
+                input_buffer_length: 3,
+                io_control_code: AnyIoCtlCode(0x0009_0028),
+            },
+            input_buffer: vec![9, 8, 7],
+        };
+        assert!(backend.handle_drive_device_control(dc_req).unwrap().is_empty());
+        match rx.try_recv().unwrap() {
+            RdpInputEvent::DriveRequest(DriveBackendMessage::Request(DriveRequestPayload::DeviceControl {
+                io_control_code,
+                input_buffer,
+                ..
+            })) => {
+                assert_eq!(io_control_code, 0x0009_0028);
+                assert_eq!(input_buffer, vec![9, 8, 7]);
+            }
+            other => panic!("unexpected event: {other:?}"),
+        }
+        let dc_msg = backend
+            .complete_response(DriveResponse::DeviceControl {
+                device_id: 10,
+                completion_id: 600,
+                status: NtStatus::SUCCESS,
+                output_buffer: vec![1, 2],
+            })
+            .unwrap()
+            .expect("device_control completion");
+        let dc_encoded = dc_msg.encode_unframed_pdu().unwrap();
+        assert_eq!(decode_completion_header(&dc_encoded).4, 0);
+        assert_eq!(u32::from_le_bytes(dc_encoded[16..20].try_into().unwrap()), 2);
+        assert_eq!(&dc_encoded[20..22], &[1, 2]);
+
+        // Flush, LockControl, NotifyChangeDirectory
+        backend
+            .handle_drive_io_request(ServerDriveIoRequest::DeviceFlushBuffersRequest(
+                DeviceFlushBuffersRequest {
+                    device_io_request: make_io_req(10, 1, 601, MajorFunction::FlushBuffers),
+                },
+            ))
+            .unwrap();
+        let _ = rx.try_recv().unwrap();
+        assert!(
+            backend
+                .complete_response(DriveResponse::Flush {
+                    device_id: 10,
+                    completion_id: 601,
+                    status: NtStatus::SUCCESS,
+                })
+                .unwrap()
+                .is_some()
+        );
+
+        backend
+            .handle_drive_io_request(ServerDriveIoRequest::ServerDriveLockControlRequest(
+                ServerDriveLockControlRequest {
+                    device_io_request: make_io_req(10, 1, 602, MajorFunction::LockControl),
+                    operation: LockOperation::Exclusive,
+                    wait: false,
+                    locks: vec![RdpLockInfo { offset: 0, length: 16 }],
+                },
+            ))
+            .unwrap();
+        let _ = rx.try_recv().unwrap();
+        assert!(
+            backend
+                .complete_response(DriveResponse::LockControl {
+                    device_id: 10,
+                    completion_id: 602,
+                    status: NtStatus::SUCCESS,
+                })
+                .unwrap()
+                .is_some()
+        );
+
+        backend
+            .handle_drive_io_request(ServerDriveIoRequest::ServerDriveNotifyChangeDirectoryRequest(
+                ServerDriveNotifyChangeDirectoryRequest {
+                    device_io_request: DeviceIoRequest {
+                        device_id: 10,
+                        file_id: 1,
+                        completion_id: 603,
+                        major_function: MajorFunction::DirectoryControl,
+                        minor_function: MinorFunction::IRP_MN_NOTIFY_CHANGE_DIRECTORY,
+                    },
+                    watch_tree: 1,
+                    completion_filter: 0x17,
+                },
+            ))
+            .unwrap();
+        let _ = rx.try_recv().unwrap();
+        assert!(
+            backend
+                .complete_response(DriveResponse::NotifyChangeDirectory {
+                    device_id: 10,
+                    completion_id: 603,
+                    status: NtStatus::NOT_SUPPORTED,
+                    buffer: Vec::new(),
+                })
+                .unwrap()
+                .is_some()
+        );
+    }
+}

+/// RDPDR backend that delegates drive IRPs asynchronously to JS and optionally
+/// delegates printer IRPs to [`WasmPrinterBackend`].
+#[derive(Debug)]
+pub(crate) struct WasmDriveBackend {
+    tx: mpsc::UnboundedSender<RdpInputEvent>,
+    active_drives: HashSet<u32>,
+    pending_irps: HashMap<(u32, u32), PendingDriveIrp>,
+    printer: Option<WasmPrinterBackend>,
+}
+
+impl_as_any!(WasmDriveBackend);
+
+impl WasmDriveBackend {
+    pub(crate) fn new(tx: mpsc::UnboundedSender<RdpInputEvent>) -> Self {
+        Self {
+            tx,
+            active_drives: HashSet::new(),
+            pending_irps: HashMap::new(),
+            printer: None,
+        }
+    }
+
+    #[must_use]
+    pub(crate) fn with_printer(mut self, printer: WasmPrinterBackend) -> Self {
+        self.printer = Some(printer);
+        self
+    }
+
+    fn send_to_loop(&self, msg: DriveBackendMessage) -> bool {
+        if self.tx.unbounded_send(RdpInputEvent::DriveRequest(msg)).is_err() {
+            warn!("Drive request dropped: session event loop receiver is closed");
+            return false;
+        }
+        true
+    }
+
+    /// Completes a previously deferred drive IRP with the response returned by JS.
+    ///
+    /// Returns `Ok(None)` if the response is a reset acknowledgement or references a
+    /// completion that was already cancelled/reset.
+    pub(crate) fn complete_response(&mut self, response: DriveResponse) -> PduResult<Option<SvcMessage>> {
+        let (device_id, completion_id) = match &response {
+            DriveResponse::Reset => return Ok(None),
+            DriveResponse::Create {
+                device_id,
+                completion_id,
+                ..
+            }
+            | DriveResponse::Close {
+                device_id,
+                completion_id,
+                ..
+            }
+            | DriveResponse::Read {
+                device_id,
+                completion_id,
+                ..
+            }
+            | DriveResponse::Write {
+                device_id,
+                completion_id,
+                ..
+            }
+            | DriveResponse::QueryDirectory {
+                device_id,
+                completion_id,
+                ..
+            }
+            | DriveResponse::QueryInformation {
+                device_id,
+                completion_id,
+                ..
+            }
+            | DriveResponse::QueryVolumeInformation {
+                device_id,
+                completion_id,
+                ..
+            }
+            | DriveResponse::SetInformation {
+                device_id,
+                completion_id,
+                ..
+            }
+            | DriveResponse::Flush {
+                device_id,
+                completion_id,
+                ..
+            }
+            | DriveResponse::LockControl {
+                device_id,
+                completion_id,
+                ..
+            }
+            | DriveResponse::DeviceControl {
+                device_id,
+                completion_id,
+                ..
+            }
+            | DriveResponse::NotifyChangeDirectory {
+                device_id,
+                completion_id,
+                ..
+            } => (*device_id, *completion_id),
+        };
+
+        let Some(pending) = self.pending_irps.remove(&(device_id, completion_id)) else {
+            debug!(
+                device_id,
+                completion_id, "Ignoring RDPDR drive response for unknown or cancelled completion"
+            );
+            return Ok(None);
+        };
+
+        let pdu = encode_drive_completion(pending, response)?;
+        Ok(Some(SvcMessage::from(pdu)))
+    }
+}
+
+fn encode_drive_completion(pending: PendingDriveIrp, response: DriveResponse) -> PduResult<RdpdrPdu> {
+    match (pending, response) {
+        (
+            PendingDriveIrp::Create(io_req),
+            DriveResponse::Create {
+                status,
+                file_id,
+                information,
+                ..
+            },
+        ) => Ok(RdpdrPdu::DeviceCreateResponse(DeviceCreateResponse {
+            device_io_reply: DeviceIoResponse::new(io_req, status),
+            file_id: if status == NtStatus::SUCCESS { file_id } else { 0 },
+            information: if status == NtStatus::SUCCESS {
+                information
+            } else {
+                Information::empty()
+            },
+        })),
+        (PendingDriveIrp::Close(io_req), DriveResponse::Close { status, .. }) => {
+            Ok(RdpdrPdu::DeviceCloseResponse(DeviceCloseResponse {
+                device_io_response: DeviceIoResponse::new(io_req, status),
+            }))
+        }
+        (PendingDriveIrp::Read(io_req), DriveResponse::Read { status, data, .. }) => {
+            Ok(RdpdrPdu::DeviceReadResponse(DeviceReadResponse {
+                device_io_reply: DeviceIoResponse::new(io_req, status),
+                read_data: if status == NtStatus::SUCCESS { data } else { Vec::new() },
+            }))
+        }
+        (
+            PendingDriveIrp::Write(io_req),
+            DriveResponse::Write {
+                status, bytes_written, ..
+            },
+        ) => Ok(RdpdrPdu::DeviceWriteResponse(DeviceWriteResponse {
+            device_io_reply: DeviceIoResponse::new(io_req, status),
+            length: if status == NtStatus::SUCCESS { bytes_written } else { 0 },
+        })),
+        (
+            PendingDriveIrp::QueryDirectory { io_req, info_class },
+            DriveResponse::QueryDirectory {
+                status,
+                information_class,
+                entry,
+                ..
+            },
+        ) => {
+            let class = information_class.map(FileInformationClassLevel::from).unwrap_or(info_class);
+            let (effective_status, buffer) = if status == NtStatus::SUCCESS {
+                if let Some(entry) = entry {
+                    match build_directory_info_class(&class, entry) {
+                        Some(buf) => (NtStatus::SUCCESS, Some(buf)),
+                        None => (NtStatus::NOT_SUPPORTED, None),
+                    }
+                } else {
+                    (NtStatus::NO_MORE_FILES, None)
+                }
+            } else {
+                (status, None)
+            };
+            Ok(RdpdrPdu::ClientDriveQueryDirectoryResponse(
+                ClientDriveQueryDirectoryResponse {
+                    device_io_reply: DeviceIoResponse::new(io_req, effective_status),
+                    buffer,
+                },
+            ))
+        }
+        (
+            PendingDriveIrp::QueryInformation { io_req, info_class },
+            DriveResponse::QueryInformation { status, info, .. },
+        ) => {
+            let (effective_status, buffer) = if status == NtStatus::SUCCESS {
+                match info {
+                    Some(DriveFileInfo::Basic(basic)) => (NtStatus::SUCCESS, Some(FileInformationClass::Basic(basic))),
+                    Some(DriveFileInfo::Standard(standard)) => {
+                        (NtStatus::SUCCESS, Some(FileInformationClass::Standard(standard)))
+                    }
+                    Some(DriveFileInfo::AttributeTag(attr)) => {
+                        (NtStatus::SUCCESS, Some(FileInformationClass::AttributeTag(attr)))
+                    }
+                    None => {
+                        warn!(?info_class, "QueryInformation success response missing info payload");
+                        (NtStatus::UNSUCCESSFUL, None)
+                    }
+                }
+            } else {
+                (status, None)
+            };
+            Ok(RdpdrPdu::ClientDriveQueryInformationResponse(
+                ClientDriveQueryInformationResponse {
+                    device_io_response: DeviceIoResponse::new(io_req, effective_status),
+                    buffer,
+                },
+            ))
+        }
+        (
+            PendingDriveIrp::QueryVolumeInformation { io_req, fs_info_class },
+            DriveResponse::QueryVolumeInformation { status, info, .. },
+        ) => {
+            let (effective_status, buffer) = if status == NtStatus::SUCCESS {
+                match info {
+                    Some(info) => (NtStatus::SUCCESS, Some(build_volume_info_class(info))),
+                    None => {
+                        warn!(
+                            ?fs_info_class,
+                            "QueryVolumeInformation success response missing info payload"
+                        );
+                        (NtStatus::UNSUCCESSFUL, None)
+                    }
+                }
+            } else {
+                (status, None)
+            };
+            Ok(RdpdrPdu::ClientDriveQueryVolumeInformationResponse(
+                ClientDriveQueryVolumeInformationResponse {
+                    device_io_reply: DeviceIoResponse::new(io_req, effective_status),
+                    buffer,
+                },
+            ))
+        }
+        (PendingDriveIrp::SetInformation(orig_req), DriveResponse::SetInformation { status, .. }) => {
+            let pdu = ClientDriveSetInformationResponse::new(&orig_req, status).map_err(|e| encode_err!(e))?;
+            Ok(RdpdrPdu::ClientDriveSetInformationResponse(pdu))
+        }
+        (PendingDriveIrp::Flush(io_req), DriveResponse::Flush { status, .. }) => {
+            Ok(RdpdrPdu::DeviceFlushBuffersResponse(DeviceFlushBuffersResponse {
+                device_io_response: DeviceIoResponse::new(io_req, status),
+            }))
+        }
+        (PendingDriveIrp::LockControl(io_req), DriveResponse::LockControl { status, .. }) => Ok(
+            RdpdrPdu::ClientDriveLockControlResponse(ClientDriveLockControlResponse::new(io_req, status)),
+        ),
+        (
+            PendingDriveIrp::DeviceControl(io_req),
+            DriveResponse::DeviceControl {
+                status, output_buffer, ..
+            },
+        ) => Ok(RdpdrPdu::DeviceControlResponse(
+            DeviceControlResponse::with_raw_output(
+                io_req,
+                status,
+                if status == NtStatus::SUCCESS {
+                    output_buffer
+                } else {
+                    Vec::new()
+                },
+            ),
+        )),
+        (
+            PendingDriveIrp::NotifyChangeDirectory(io_req),
+            DriveResponse::NotifyChangeDirectory { status, buffer, .. },
+        ) => Ok(RdpdrPdu::ClientDriveNotifyChangeDirectoryResponse(
+            ClientDriveNotifyChangeDirectoryResponse::new(
+                io_req,
+                status,
+                if status == NtStatus::SUCCESS { buffer } else { Vec::new() },
+            ),
+        )),
+        (pending, response) => {
+            warn!(?pending, ?response, "Mismatched RDPDR drive response op; failing IRP");
+            // Complete with UNSUCCESSFUL using the pending IRP's expected wire format.
+            let pdu = match pending {
+                PendingDriveIrp::Create(io_req) => RdpdrPdu::DeviceCreateResponse(DeviceCreateResponse {
+                    device_io_reply: DeviceIoResponse::new(io_req, NtStatus::UNSUCCESSFUL),
+                    file_id: 0,
+                    information: Information::empty(),
+                }),
+                PendingDriveIrp::Close(io_req) => RdpdrPdu::DeviceCloseResponse(DeviceCloseResponse {
+                    device_io_response: DeviceIoResponse::new(io_req, NtStatus::UNSUCCESSFUL),
+                }),
+                PendingDriveIrp::Read(io_req) => RdpdrPdu::DeviceReadResponse(DeviceReadResponse {
+                    device_io_reply: DeviceIoResponse::new(io_req, NtStatus::UNSUCCESSFUL),
+                    read_data: Vec::new(),
+                }),
+                PendingDriveIrp::Write(io_req) => RdpdrPdu::DeviceWriteResponse(DeviceWriteResponse {
+                    device_io_reply: DeviceIoResponse::new(io_req, NtStatus::UNSUCCESSFUL),
+                    length: 0,
+                }),
+                PendingDriveIrp::QueryDirectory { io_req, .. } => {
+                    RdpdrPdu::ClientDriveQueryDirectoryResponse(ClientDriveQueryDirectoryResponse {
+                        device_io_reply: DeviceIoResponse::new(io_req, NtStatus::UNSUCCESSFUL),
+                        buffer: None,
+                    })
+                }
+                PendingDriveIrp::QueryInformation { io_req, .. } => {
+                    RdpdrPdu::ClientDriveQueryInformationResponse(ClientDriveQueryInformationResponse {
+                        device_io_response: DeviceIoResponse::new(io_req, NtStatus::UNSUCCESSFUL),
+                        buffer: None,
+                    })
+                }
+                PendingDriveIrp::QueryVolumeInformation { io_req, .. } => {
+                    RdpdrPdu::ClientDriveQueryVolumeInformationResponse(ClientDriveQueryVolumeInformationResponse {
+                        device_io_reply: DeviceIoResponse::new(io_req, NtStatus::UNSUCCESSFUL),
+                        buffer: None,
+                    })
+                }
+                PendingDriveIrp::SetInformation(req) => RdpdrPdu::ClientDriveSetInformationResponse(
+                    ClientDriveSetInformationResponse::new(&req, NtStatus::UNSUCCESSFUL).map_err(|e| encode_err!(e))?,
+                ),
+                PendingDriveIrp::Flush(io_req) => RdpdrPdu::DeviceFlushBuffersResponse(DeviceFlushBuffersResponse {
+                    device_io_response: DeviceIoResponse::new(io_req, NtStatus::UNSUCCESSFUL),
+                }),
+                PendingDriveIrp::LockControl(io_req) => RdpdrPdu::ClientDriveLockControlResponse(
+                    ClientDriveLockControlResponse::new(io_req, NtStatus::UNSUCCESSFUL),
+                ),
+                PendingDriveIrp::DeviceControl(io_req) => RdpdrPdu::DeviceControlResponse(DeviceControlResponse {
+                    device_io_reply: DeviceIoResponse::new(io_req, NtStatus::UNSUCCESSFUL),
+                    output_buffer: None,
+                }),
+                PendingDriveIrp::NotifyChangeDirectory(io_req) => RdpdrPdu::ClientDriveNotifyChangeDirectoryResponse(
+                    ClientDriveNotifyChangeDirectoryResponse::new(io_req, NtStatus::UNSUCCESSFUL, Vec::new()),
+                ),
+            };
+            Ok(pdu)
+        }
+    }
+}

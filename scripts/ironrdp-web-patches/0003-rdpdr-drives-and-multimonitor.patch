+/// Metadata retained for each in-flight IRP so completions can be encoded faithfully
+/// (and cleanly cancelled if the drive is removed or the channel resets).
+#[derive(Debug)]
+enum PendingDriveIrp {
+    Create(DeviceIoRequest),
+    Close(DeviceIoRequest),
+    Read(DeviceIoRequest),
+    Write(DeviceIoRequest),
+    QueryDirectory {
+        io_req: DeviceIoRequest,
+        info_class: FileInformationClassLevel,
+    },
+    QueryInformation {
+        io_req: DeviceIoRequest,
+        info_class: FileInformationClassLevel,
+    },
+    QueryVolumeInformation {
+        io_req: DeviceIoRequest,
+        fs_info_class: FileSystemInformationClassLevel,
+    },
+    SetInformation(ServerDriveSetInformationRequest),
+    Flush(DeviceIoRequest),
+    LockControl(DeviceIoRequest),
+    DeviceControl(DeviceIoRequest),
+    NotifyChangeDirectory(DeviceIoRequest),
+}
+
+impl PendingDriveIrp {
+    fn cancel_message(self) -> PduResult<SvcMessage> {
+        let cancelled = status_cancelled();
+        let pdu = match self {
+            Self::Create(io_req) => RdpdrPdu::DeviceCreateResponse(DeviceCreateResponse {
+                device_io_reply: DeviceIoResponse::new(io_req, cancelled),
+                file_id: 0,
+                information: Information::empty(),
+            }),
+            Self::Close(io_req) => RdpdrPdu::DeviceCloseResponse(DeviceCloseResponse {
+                device_io_response: DeviceIoResponse::new(io_req, cancelled),
+            }),
+            Self::Read(io_req) => RdpdrPdu::DeviceReadResponse(DeviceReadResponse {
+                device_io_reply: DeviceIoResponse::new(io_req, cancelled),
+                read_data: Vec::new(),
+            }),
+            Self::Write(io_req) => RdpdrPdu::DeviceWriteResponse(DeviceWriteResponse {
+                device_io_reply: DeviceIoResponse::new(io_req, cancelled),
+                length: 0,
+            }),
+            Self::QueryDirectory { io_req, .. } => {
+                RdpdrPdu::ClientDriveQueryDirectoryResponse(ClientDriveQueryDirectoryResponse {
+                    device_io_reply: DeviceIoResponse::new(io_req, cancelled),
+                    buffer: None,
+                })
+            }
+            Self::QueryInformation { io_req, .. } => {
+                RdpdrPdu::ClientDriveQueryInformationResponse(ClientDriveQueryInformationResponse {
+                    device_io_response: DeviceIoResponse::new(io_req, cancelled),
+                    buffer: None,
+                })
+            }
+            Self::QueryVolumeInformation { io_req, .. } => {
+                RdpdrPdu::ClientDriveQueryVolumeInformationResponse(ClientDriveQueryVolumeInformationResponse {
+                    device_io_reply: DeviceIoResponse::new(io_req, cancelled),
+                    buffer: None,
+                })
+            }
+            Self::SetInformation(req) => RdpdrPdu::ClientDriveSetInformationResponse(
+                ClientDriveSetInformationResponse::new(&req, cancelled).map_err(|e| encode_err!(e))?,
+            ),
+            Self::Flush(io_req) => RdpdrPdu::DeviceFlushBuffersResponse(DeviceFlushBuffersResponse {
+                device_io_response: DeviceIoResponse::new(io_req, cancelled),
+            }),
+            Self::LockControl(io_req) => {
+                RdpdrPdu::ClientDriveLockControlResponse(ClientDriveLockControlResponse::new(io_req, cancelled))
+            }
+            Self::DeviceControl(io_req) => RdpdrPdu::DeviceControlResponse(DeviceControlResponse {
+                device_io_reply: DeviceIoResponse::new(io_req, cancelled),
+                output_buffer: None,
+            }),
+            Self::NotifyChangeDirectory(io_req) => RdpdrPdu::ClientDriveNotifyChangeDirectoryResponse(
+                ClientDriveNotifyChangeDirectoryResponse::new(io_req, cancelled, Vec::new()),
+            ),
+        };
+        Ok(SvcMessage::from(pdu))
+    }
+}

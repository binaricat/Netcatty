+/// Normalized monitor specification for MS-RDPEDISP `set_monitor_layout`.
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct MonitorLayoutSpec {
+    left: i32,
+    top: i32,
+    width: u32,
+    height: u32,
+    is_primary: Option<bool>,
+    scale_factor: Option<u32>,
+    physical_width: Option<u32>,
+    physical_height: Option<u32>,
+}
+
+/// Converts a JS scale factor into MS-RDPEDISP desktop scale percentage (`100..=500`).
+///
+/// Accepts either DPR multipliers (`1.0..=5.0`, such as Electron's `display.scaleFactor`)
+/// or explicit percentages (`100..=500`).
+fn normalize_scale_factor_percent(raw: f64) -> Option<u32> {
+    if !raw.is_finite() || raw <= 0.0 {
+        return None;
+    }
+    let pct = if raw <= 5.0 { (raw * 100.0).round() } else { raw.round() };
+    if !(100.0..=500.0).contains(&pct) {
+        return None;
+    }
+    #[expect(
+        clippy::as_conversions,
+        clippy::cast_possible_truncation,
+        clippy::cast_sign_loss,
+        reason = "clamped finite integral scale factor within 100..=500"
+    )]
+    Some(pct as u32)
+}
+
+fn parse_display_control_monitor_layout(value: JsValue) -> Result<Vec<MonitorLayoutSpec>, IronError> {
+    if !js_sys::Array::is_array(&value) {
+        return Err(anyhow::anyhow!("set_monitor_layout expects an array of monitor objects").into());
+    }
+    let arr = js_sys::Array::from(&value);
+    let len = usize::try_from(arr.length()).unwrap_or(0);
+    if len == 0 {
+        return Err(anyhow::anyhow!("set_monitor_layout requires at least one monitor").into());
+    }
+
+    let mut specs = Vec::with_capacity(len);
+    for idx in 0..arr.length() {
+        let obj = into_object(arr.get(idx))?;
+        let left = get_i32(&obj, "left")?;
+        let top = get_i32(&obj, "top")?;
+        let width = get_u32(&obj, "width")?;
+        let height = get_u32(&obj, "height")?;
+
+        let is_primary_val = js_sys::Reflect::get(&obj, &JsValue::from_str("isPrimary"))
+            .map_err(|e| anyhow::anyhow!("get property `isPrimary`: {e:?}"))?;
+        let is_primary = if is_primary_val.is_undefined() || is_primary_val.is_null() {
+            None
+        } else {
+            Some(
+                is_primary_val
+                    .as_bool()
+                    .context("invalid type for property `isPrimary`")?,
+            )
+        };
+
+        let scale_val = js_sys::Reflect::get(&obj, &JsValue::from_str("scaleFactor"))
+            .map_err(|e| anyhow::anyhow!("get property `scaleFactor`: {e:?}"))?;
+        let scale_factor = if scale_val.is_undefined() || scale_val.is_null() {
+            None
+        } else {
+            let f = scale_val
+                .as_f64()
+                .context("invalid type for property `scaleFactor`")?;
+            normalize_scale_factor_percent(f)
+        };
+
+        let physical_width = get_u32_opt(&obj, "physicalWidth")?;
+        let physical_height = get_u32_opt(&obj, "physicalHeight")?;
+
+        specs.push(MonitorLayoutSpec {
+            left,
+            top,
+            width,
+            height,
+            is_primary,
+            scale_factor,
+            physical_width,
+            physical_height,
+        });
+    }
+
+    Ok(specs)
+}
+
+fn build_display_control_monitor_layout(specs: &[MonitorLayoutSpec]) -> anyhow::Result<DisplayControlMonitorLayout> {
+    if specs.is_empty() {
+        anyhow::bail!("monitor layout must contain at least one monitor");
+    }
+
+    let explicit_primaries: Vec<usize> = specs
+        .iter()
+        .enumerate()
+        .filter_map(|(idx, m)| (m.is_primary == Some(true)).then_some(idx))
+        .collect();
+
+    let primary_index = match explicit_primaries.as_slice() {
+        [only] => *only,
+        [] => specs
+            .iter()
+            .position(|m| m.left == 0 && m.top == 0)
+            .unwrap_or(0),
+        _ => anyhow::bail!("monitor layout must have at most one primary monitor"),
+    };
+
+    let origin_left = specs[primary_index].left;
+    let origin_top = specs[primary_index].top;
+
+    let mut entries = Vec::with_capacity(specs.len());
+    for (idx, spec) in specs.iter().enumerate() {
+        let (width, height) = MonitorLayoutEntry::adjust_display_size(spec.width, spec.height);
+        let left = spec
+            .left
+            .checked_sub(origin_left)
+            .context("monitor left coordinate overflow")?;
+        let top = spec
+            .top
+            .checked_sub(origin_top)
+            .context("monitor top coordinate overflow")?;
+
+        let mut entry = if idx == primary_index {
+            MonitorLayoutEntry::new_primary(width, height)?
+        } else {
+            MonitorLayoutEntry::new_secondary(width, height)?
+        };
+        entry = entry.with_position(left, top)?;
+        entry = entry.with_orientation(if width < height {
+            MonitorOrientation::Portrait
+        } else {
+            MonitorOrientation::Landscape
+        });
+
+        if let Some(scale) = spec.scale_factor {
+            let desktop_scale = MonitorLayoutEntry::adjust_desktop_scale_factor(scale);
+            entry = entry
+                .with_desktop_scale_factor(desktop_scale)?
+                .with_device_scale_factor(DeviceScaleFactor::from_desktop_scale_factor(desktop_scale));
+        }
+
+        if let (Some(pw), Some(ph)) = (spec.physical_width, spec.physical_height) {
+            if (10..=10_000).contains(&pw) && (10..=10_000).contains(&ph) {
+                entry = entry.with_physical_dimensions(pw, ph)?;
+            }
+        }
+
+        entries.push(entry);
+    }
+
+    Ok(DisplayControlMonitorLayout::new(&entries)?)
+}
+
+/// Decodes the three raw u32 fields (`MaxNumMonitors`, `MaxMonitorAreaFactorA`, `MaxMonitorAreaFactorB`)
+/// and total `max_monitor_area` from [`DisplayControlCapabilities`].
+fn decode_display_control_caps(caps: DisplayControlCapabilities) -> (u32, u32, u32, u64) {
+    let encoded = ironrdp_core::encode_vec(&caps).unwrap_or_default();
+    if encoded.len() >= 12 {
+        let max_num = u32::from_le_bytes([encoded[0], encoded[1], encoded[2], encoded[3]]);
+        let factor_a = u32::from_le_bytes([encoded[4], encoded[5], encoded[6], encoded[7]]);
+        let factor_b = u32::from_le_bytes([encoded[8], encoded[9], encoded[10], encoded[11]]);
+        (max_num, factor_a, factor_b, caps.max_monitor_area())
+    } else {
+        (caps.max_num_monitors(), 0, 0, caps.max_monitor_area())
+    }
+}
+
+fn display_control_caps_to_js(caps: DisplayControlCapabilities) -> JsValue {
+    let (max_num_monitors, factor_a, factor_b, max_monitor_area) = decode_display_control_caps(caps);
+    let obj = js_sys::Object::new();
+    let _ = js_sys::Reflect::set(
+        &obj,
+        &JsValue::from_str("maxNumMonitors"),
+        &JsValue::from(max_num_monitors),
+    );
+    let _ = js_sys::Reflect::set(
+        &obj,
+        &JsValue::from_str("maxMonitorAreaFactorA"),
+        &JsValue::from(factor_a),
+    );
+    let _ = js_sys::Reflect::set(
+        &obj,
+        &JsValue::from_str("maxMonitorAreaFactorB"),
+        &JsValue::from(factor_b),
+    );
+    #[expect(
+        clippy::as_conversions,
+        clippy::cast_precision_loss,
+        reason = "max_monitor_area fits well within IEEE-754 exact integer range (<= 2^39)"
+    )]
+    let _ = js_sys::Reflect::set(
+        &obj,
+        &JsValue::from_str("maxMonitorArea"),
+        &JsValue::from_f64(max_monitor_area as f64),
+    );
+    obj.into()
+}

+    fn decode_completion_header(bytes: &[u8]) -> (u16, u16, u32, u32, u32) {
+        assert!(bytes.len() >= 16, "completion shorter than header: {}", bytes.len());
+        let component = u16::from_le_bytes([bytes[0], bytes[1]]);
+        let packet_id = u16::from_le_bytes([bytes[2], bytes[3]]);
+        let device_id = u32::from_le_bytes([bytes[4], bytes[5], bytes[6], bytes[7]]);
+        let completion_id = u32::from_le_bytes([bytes[8], bytes[9], bytes[10], bytes[11]]);
+        let status = u32::from_le_bytes([bytes[12], bytes[13], bytes[14], bytes[15]]);
+        (component, packet_id, device_id, completion_id, status)
+    }

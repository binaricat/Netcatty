+        // (GitHub issue #4482, rdp_mstsc.pcapng packet [03], 337 bytes).
+        const WIN2003_CONNECT_RESPONSE_HEX: &str = concat!(
+            "0300015102f0807f668201450a0100020100301a020122020103020100020101020100020101020300fff80201020482011f",
+            "000500147c00012a14760a01010001c0004d63446e8108010c0c000400080000000000030c1000eb030400ec03ed03ee03ef",
+            "03020cec00020000000200000020000000b800000023286d5fcf9e721276aef900cd57357ad5a7994d36c54536c329ae4378",
+            "0b4f6601000000010000000100000006005c005253413148000000000200003f000000010001005534e90f476b234d5136a9",
+            "e51bbcc948e7637149c89e493bfb2779e2f152f0ad6ffba9e852cffd756b2cf1e779ad63e4d9fc7400ca1a9348d72e240fcd",
+            "25a6be00000000000000000800480086bb2e368312a7f431b4590216ea1cc7c650faa0ba6167da818e828a85e7330f679cfc",
+            "99fa9155627628071ef2cf56e5ea7f64e1586a03b85d4463cd6264675f0000000000000000"
+        );
+        let bytes: Vec<u8> = (0..WIN2003_CONNECT_RESPONSE_HEX.len())
+            .step_by(2)
+            .map(|i| u8::from_str_radix(&WIN2003_CONNECT_RESPONSE_HEX[i..i + 2], 16).unwrap())
+            .collect();
+
+        let x224_data = decode::<X224<X224Data<'_>>>(&bytes).unwrap().0;
+        let connect_response = decode::<ConnectResponse>(x224_data.data.as_ref()).unwrap();
+        let sc_security = &connect_response.conference_create_response.gcc_blocks().security;
+
+        assert_eq!(sc_security.encryption_method, EncryptionMethod::BIT_128);
+        assert_eq!(sc_security.encryption_level, EncryptionLevel::ClientCompatible);
+        assert_eq!(sc_security.server_cert.len(), 184);
+
+        let client_random = [0x42u8; 32];
+        let (sec, exchange_pdu) = StandardRdpSecurity::new_client(sc_security, client_random, None).unwrap();
+        assert_eq!(sec.info().encryption_method, EncryptionMethod::BIT_128);
+        assert_eq!(sec.info().encryption_level, EncryptionLevel::ClientCompatible);
+        // 512-bit RSA modulus -> 64 bytes ciphertext + 8 bytes zero padding = 72 bytes (0x48)
+        assert_eq!(exchange_pdu.encrypted_client_random.len(), 72);
+        assert_eq!(&exchange_pdu.encrypted_client_random[64..72], &[0u8; 8]);
+
+        let encoded = encode_vec(&exchange_pdu).unwrap();
+        let decoded = decode::<SecurityExchangePdu>(&encoded).unwrap();
+        assert_eq!(decoded, exchange_pdu);
+    }
+
+    #[test]
+    fn roundtrip_all_methods_slow_path_and_fast_path() {
+        let client_random = [0x11u8; 32];
+        let server_random = [0x22u8; 32];
+
+        for (method, level) in [
+            (EncryptionMethod::BIT_40, EncryptionLevel::ClientCompatible),
+            (EncryptionMethod::BIT_56, EncryptionLevel::ClientCompatible),
+            (EncryptionMethod::BIT_128, EncryptionLevel::ClientCompatible),
+            (EncryptionMethod::BIT_128, EncryptionLevel::High),
+            (EncryptionMethod::FIPS, EncryptionLevel::Fips),
+        ] {
+            let (mut client, mut server) =
+                StandardRdpSecurity::new_pair_for_test(method, level, client_random, server_random, Some(1009));
+
+            // 1. ClientInfoPdu (existing BasicSecurityHeader with INFO_PKT)
+            let mut client_info = vec![0x40, 0x00, 0x00, 0x00];
+            client_info.extend_from_slice(b"client-info-payload-data-1234567890");
+            let plain_ci = make_send_data_request(1003, &client_info);
+            let enc_ci = client.encrypt_frame(&plain_ci).unwrap();
+            let dec_ci = server.decryptor.decrypt_client_frame_for_test(&enc_ci).unwrap();
+            assert_eq!(dec_ci, plain_ci, "ClientInfo roundtrip failed for {method:?}");
+
+            // 2. Server encrypted LicensePdu with LICENSE_ENCRYPT_CS + LICENSE_ENCRYPT_SC
+            let mut server_lic = vec![0x80, 0x00, 0x00, 0x00];
+            server_lic.extend_from_slice(b"license-error-valid-client");
+            let plain_slic = make_send_data_indication(1003, &server_lic);
+            let enc_slic = server
+                .encryptor
+                .encrypt_server_frame_for_test(
+                    &plain_slic,
+                    BasicSecurityHeaderFlags::LICENSE_PKT
+                        | BasicSecurityHeaderFlags::LICENSE_ENCRYPT_CS
+                        | BasicSecurityHeaderFlags::LICENSE_ENCRYPT_SC,
+                    0x0000,
+                )
+                .unwrap();
+            let dec_slic = client.decrypt_frame(&enc_slic).unwrap();
+            assert_eq!(dec_slic, plain_slic, "Server License roundtrip failed for {method:?}");
+
+            // 3. Server ShareControl PDU with non-zero flagsHi (0x0302, like Windows 2003 R2!)
+            let demand_active_payload = b"\x20\x00\x11\x00\xea\x03\x01\x00\x01\x00demand-active-body";
+            let plain_da = make_send_data_indication(1003, demand_active_payload);
+            let enc_da = server
+                .encryptor
+                .encrypt_server_frame_for_test(&plain_da, BasicSecurityHeaderFlags::empty(), 0x0302)
+                .unwrap();
+            let dec_da = client.decrypt_frame(&enc_da).unwrap();
+            assert_eq!(dec_da, plain_da, "DemandActive roundtrip failed for {method:?}");
+
+            // 4. Concatenated multi-TPKT outbound frames (ConnectionFinalization style)
+            let pdu1 = make_send_data_request(1003, b"\x16\x00\x17\x00\xf0\x03sync-pdu");
+            let pdu2 = make_send_data_request(1003, b"\x18\x00\x17\x00\xf0\x03control-pdu");
+            let combined = [pdu1.as_slice(), pdu2.as_slice()].concat();
+            let enc_combined = client.encrypt_frames(&combined).unwrap();
+            let len1 = next_frame_len(&enc_combined).unwrap();
+            let dec1 = server.decryptor.decrypt_client_frame_for_test(&enc_combined[..len1]).unwrap();
+            let dec2 = server.decryptor.decrypt_client_frame_for_test(&enc_combined[len1..]).unwrap();
+            assert_eq!(dec1, pdu1);
+            assert_eq!(dec2, pdu2);
+
+            // 5. Fast-Path Input (both inline numEvents < 16 and extra byte >= 16)
+            let fp_in_small = vec![0x04, 0x07, 0x01, 0x02, 0x03, 0x04, 0x05]; // 1 event
+            let enc_fp_in = client.encrypt_frame(&fp_in_small).unwrap();
+            assert_ne!(enc_fp_in[0] & 0x80, 0);
+            let dec_fp_in = server.decryptor.decrypt_client_frame_for_test(&enc_fp_in).unwrap();
+            assert_eq!(dec_fp_in, fp_in_small, "FastPath input roundtrip failed for {method:?}");
+
+            let mut fp_in_many = vec![0x00, 0x09, 0x10, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF]; // 16 events
+            fp_in_many[1] = u8::try_from(fp_in_many.len()).unwrap();
+            let enc_fp_many = client.encrypt_frame(&fp_in_many).unwrap();
+            let dec_fp_many = server.decryptor.decrypt_client_frame_for_test(&enc_fp_many).unwrap();
+            assert_eq!(dec_fp_many, fp_in_many);
+
+            // 6. Fast-Path Output (server -> client)
+            let fp_body = b"\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b";
+            let fp_hdr = FastPathHeader::new(EncryptionFlags::empty(), fp_body.len());
+            let mut plain_fp_out = encode_vec(&fp_hdr).unwrap();
+            plain_fp_out.extend_from_slice(fp_body);
+            let enc_fp_out = server
+                .encryptor
+                .encrypt_server_frame_for_test(&plain_fp_out, BasicSecurityHeaderFlags::empty(), 0)
+                .unwrap();
+            let dec_fp_out = client.decrypt_frame(&enc_fp_out).unwrap();
+            assert_eq!(dec_fp_out, plain_fp_out, "FastPath output roundtrip failed for {method:?}");
+        }
+    }
+
+    #[test]
+    fn encryption_level_low_only_encrypts_client_to_server() {
+        let (mut client, mut server) = StandardRdpSecurity::new_pair_for_test(
+            EncryptionMethod::BIT_40,
+            EncryptionLevel::Low,
+            [0x33u8; 32],
+            [0x44u8; 32],
+            None,
+        );
+
+        let plain_c2s = make_send_data_request(1003, b"client-secret-data");
+        let enc_c2s = client.encrypt_frame(&plain_c2s).unwrap();
+        assert_ne!(enc_c2s, plain_c2s);
+        let dec_c2s = server.decryptor.decrypt_client_frame_for_test(&enc_c2s).unwrap();
+        assert_eq!(dec_c2s, plain_c2s);
+
+        let plain_s2c = make_send_data_indication(1003, b"plaintext-server-data");
+        let dec_s2c = client.decrypt_frame(&plain_s2c).unwrap();
+        assert_eq!(dec_s2c, plain_s2c);
+    }
+
+    #[test]
+    fn rc4_key_update_at_4096_packets_and_salted_mac_stay_in_sync() {
+        let (mut client, mut server) = StandardRdpSecurity::new_pair_for_test(
+            EncryptionMethod::BIT_128,
+            EncryptionLevel::ClientCompatible,
+            [0x55u8; 32],
+            [0x66u8; 32],
+            None,
+        );
+        server.encryptor.set_use_salted_checksum(true);
+        client.encryptor.set_use_salted_checksum(true);
+
+        // Drive 4105 packets across the 4096-packet key-update boundary in both directions.
+        for i in 0..4105u32 {
+            let payload = format!("packet-{i:05}");
+            let plain_s2c = make_send_data_indication(1003, payload.as_bytes());
+            let enc_s2c = server
+                .encryptor
+                .encrypt_server_frame_for_test(&plain_s2c, BasicSecurityHeaderFlags::empty(), 0x0302)
+                .unwrap();
+            let dec_s2c = client.decrypt_frame(&enc_s2c).unwrap();
+            assert_eq!(dec_s2c, plain_s2c, "S->C mismatch at packet {i}");
+
+            let plain_c2s = make_send_data_request(1003, payload.as_bytes());
+            let enc_c2s = client.encrypt_frame(&plain_c2s).unwrap();
+            let dec_c2s = server.decryptor.decrypt_client_frame_for_test(&enc_c2s).unwrap();
+            assert_eq!(dec_c2s, plain_c2s, "C->S mismatch at packet {i}");
+        }
+    }
+}

+fn report_security_info(
+    callback: &js_sys::Function,
+    standard_rdp: bool,
+    info: Option<StandardRdpSecurityInfo>,
+) {
+    let obj = js_sys::Object::new();
+    let (encrypted, method, level) = match (standard_rdp, info) {
+        (false, _) => (true, "tls", "enhanced"),
+        (true, Some(sec)) => (
+            sec.encryption_level != EncryptionLevel::None && !sec.encryption_method.is_empty(),
+            standard_rdp_method_label(sec.encryption_method),
+            standard_rdp_level_label(sec.encryption_level),
+        ),
+        (true, None) => (false, "none", "none"),
+    };
+    let _ = js_sys::Reflect::set(&obj, &JsValue::from_str("standardRdp"), &JsValue::from_bool(standard_rdp));
+    let _ = js_sys::Reflect::set(&obj, &JsValue::from_str("encrypted"), &JsValue::from_bool(encrypted));
+    let _ = js_sys::Reflect::set(&obj, &JsValue::from_str("method"), &JsValue::from_str(method));
+    let _ = js_sys::Reflect::set(&obj, &JsValue::from_str("level"), &JsValue::from_str(level));
+    if let Err(error) = callback.call1(&JsValue::NULL, &obj) {
+        warn!(?error, "Security info callback failed");
+    }
+}

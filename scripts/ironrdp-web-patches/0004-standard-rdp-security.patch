+#[derive(Clone)]
+struct Rc4DirectionState {
+    method: EncryptionMethod,
+    key_len: usize,
+    mac_key: [u8; 16],
+    initial_key: [u8; 16],
+    current_key: [u8; 16],
+    cipher: Rc4,
+    use_count: u32,
+    checksum_use_count: u32,
+}
+
+impl Rc4DirectionState {
+    fn new(method: EncryptionMethod, key_len: usize, mac_key: [u8; 16], initial_key: [u8; 16]) -> Self {
+        let cipher = Rc4::new(&initial_key[..key_len]);
+        Self {
+            method,
+            key_len,
+            mac_key,
+            initial_key,
+            current_key: initial_key,
+            cipher,
+            use_count: 0,
+            checksum_use_count: 0,
+        }
+    }
+
+    fn update_session_key(&mut self) {
+        let mut sha = sha1::Sha1::new();
+        sha.update(&self.initial_key[..self.key_len]);
+        sha.update(PAD1);
+        sha.update(&self.current_key[..self.key_len]);
+        let sha_digest = sha.finalize();
+
+        let mut md5 = md5::Md5::new();
+        md5.update(&self.initial_key[..self.key_len]);
+        md5.update(PAD2);
+        md5.update(sha_digest);
+        let md5_digest = md5.finalize();
+        self.current_key.copy_from_slice(&md5_digest);
+
+        let mut tmp_rc4 = Rc4::new(&self.current_key[..self.key_len]);
+        let encrypted_key = tmp_rc4.process(&self.current_key[..self.key_len]);
+        self.current_key[..self.key_len].copy_from_slice(&encrypted_key);
+
+        if self.method == EncryptionMethod::BIT_40 {
+            self.current_key[..3].copy_from_slice(&SALT_40_56);
+        } else if self.method == EncryptionMethod::BIT_56 {
+            self.current_key[0] = SALT_40_56[0];
+        }
+
+        self.cipher = Rc4::new(&self.current_key[..self.key_len]);
+        self.use_count = 0;
+    }
+
+    fn compute_mac(&self, plaintext: &[u8], salted: bool, count: u32) -> [u8; 8] {
+        let len_le = u32::try_from(plaintext.len()).unwrap_or(u32::MAX).to_le_bytes();
+        let mut sha = sha1::Sha1::new();
+        sha.update(&self.mac_key[..self.key_len]);
+        sha.update(PAD1);
+        sha.update(len_le);
+        sha.update(plaintext);
+        if salted {
+            sha.update(count.to_le_bytes());
+        }
+        let sha_digest = sha.finalize();
+
+        let mut md5 = md5::Md5::new();
+        md5.update(&self.mac_key[..self.key_len]);
+        md5.update(PAD2);
+        md5.update(sha_digest);
+        let full = md5.finalize();
+        let mut out = [0u8; 8];
+        out.copy_from_slice(&full[..8]);
+        out
+    }
+
+    fn encrypt(&mut self, plaintext: &[u8], salted: bool) -> ([u8; 8], Vec<u8>) {
+        if self.use_count >= KEY_UPDATE_INTERVAL {
+            self.update_session_key();
+        }
+        let mac = self.compute_mac(plaintext, salted, self.checksum_use_count);
+        let ciphertext = self.cipher.process(plaintext);
+        self.use_count = self.use_count.wrapping_add(1);
+        self.checksum_use_count = self.checksum_use_count.wrapping_add(1);
+        (mac, ciphertext)
+    }
+
+    fn decrypt(&mut self, ciphertext: &[u8], expected_mac: &[u8; 8], salted: bool) -> Result<Vec<u8>, String> {
+        if self.use_count >= KEY_UPDATE_INTERVAL {
+            self.update_session_key();
+        }
+        let count_for_mac = self.checksum_use_count;
+        let plaintext = self.cipher.process(ciphertext);
+        self.use_count = self.use_count.wrapping_add(1);
+        self.checksum_use_count = self.checksum_use_count.wrapping_add(1);
+        let computed_mac = self.compute_mac(&plaintext, salted, count_for_mac);
+        if computed_mac != *expected_mac {
+            return Err(String::from("Standard RDP RC4 MAC verification failed"));
+        }
+        Ok(plaintext)
+    }
+}
+
+#[derive(Clone)]
+struct FipsDirectionState {
+    sign_key: [u8; 20],
+    cipher: TripleDesCbc,
+    use_count: u32,
+}
+
+impl FipsDirectionState {
+    fn new(sign_key: [u8; 20], des_key: [u8; 24]) -> Self {
+        Self {
+            sign_key,
+            cipher: TripleDesCbc::new(&des_key, &FIPS_INITIAL_IV),
+            use_count: 0,
+        }
+    }
+
+    fn encrypt(&mut self, plaintext: &[u8]) -> (u8, [u8; 8], Vec<u8>) {
+        let pad_len = (8 - (plaintext.len() % 8)) % 8;
+        let mac = hmac_sha1_8(&self.sign_key, plaintext, self.use_count);
+        let mut buf = Vec::with_capacity(plaintext.len() + pad_len);
+        buf.extend_from_slice(plaintext);
+        buf.resize(plaintext.len() + pad_len, 0u8);
+        self.cipher.encrypt_in_place(&mut buf);
+        self.use_count = self.use_count.wrapping_add(1);
+        (u8::try_from(pad_len).unwrap_or(0), mac, buf)
+    }
+
+    fn decrypt(&mut self, ciphertext: &[u8], pad_len: u8, expected_mac: &[u8; 8]) -> Result<Vec<u8>, String> {
+        if ciphertext.is_empty() || !ciphertext.len().is_multiple_of(8) {
+            return Err(format!(
+                "FIPS ciphertext length {} is not a non-zero multiple of 8",
+                ciphertext.len()
+            ));
+        }
+        let pad = usize::from(pad_len);
+        if pad >= 8 || pad > ciphertext.len() {
+            return Err(format!("invalid FIPS pad length {pad_len}"));
+        }
+        let mut buf = ciphertext.to_vec();
+        self.cipher.decrypt_in_place(&mut buf);
+        let unpadded_len = buf.len() - pad;
+        let count_for_mac = self.use_count;
+        self.use_count = self.use_count.wrapping_add(1);
+        let computed = hmac_sha1_8(&self.sign_key, &buf[..unpadded_len], count_for_mac);
+        if computed != *expected_mac {
+            return Err(String::from("Standard RDP FIPS HMAC-SHA1 verification failed"));
+        }
+        buf.truncate(unpadded_len);
+        Ok(buf)
+    }
+}
+
+#[derive(Clone)]
+enum DirectionCipher {
+    Rc4(Rc4DirectionState),
+    Fips(FipsDirectionState),
+}
+
+impl DirectionCipher {
+    fn is_fips(&self) -> bool {
+        matches!(self, Self::Fips(_))
+    }
+}

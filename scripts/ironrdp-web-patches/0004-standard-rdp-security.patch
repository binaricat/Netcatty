+#[derive(Clone)]
+struct DesKey {
+    subkeys: [u64; 16],
+}
+
+impl DesKey {
+    fn new(key: [u8; 8]) -> Self {
+        let key_u64 = u64::from_be_bytes(key);
+        let perm = permute(key_u64, 64, &PC1);
+        let mut c = ((perm >> 28) & 0x0FFF_FFFF) as u32;
+        let mut d = (perm & 0x0FFF_FFFF) as u32;
+        let mut subkeys = [0u64; 16];
+
+        for (i, &shift) in SHIFTS.iter().enumerate() {
+            c = ((c << shift) | (c >> (28 - shift))) & 0x0FFF_FFFF;
+            d = ((d << shift) | (d >> (28 - shift))) & 0x0FFF_FFFF;
+            let cd = (u64::from(c) << 28) | u64::from(d);
+            subkeys[i] = permute(cd, 56, &PC2);
+        }
+
+        Self { subkeys }
+    }
+
+    fn crypt_block(&self, block: u64, decrypt: bool) -> u64 {
+        let ip = permute(block, 64, &INITIAL_PERM);
+        let mut left = (ip >> 32) as u32;
+        let mut right = ip as u32;
+
+        for round in 0..16 {
+            let subkey = if decrypt {
+                self.subkeys[15 - round]
+            } else {
+                self.subkeys[round]
+            };
+            let expanded = permute(u64::from(right), 32, &EXPANSION) ^ subkey;
+            let mut s_out = 0u32;
+            for (i, sbox) in SBOX.iter().enumerate() {
+                let shift = 42 - i * 6;
+                let bits = ((expanded >> shift) & 0x3F) as usize;
+                let row = ((bits & 0x20) >> 4) | (bits & 0x01);
+                let col = (bits >> 1) & 0x0F;
+                s_out = (s_out << 4) | u32::from(sbox[row * 16 + col]);
+            }
+            let f = permute(u64::from(s_out), 32, &PERM_P) as u32;
+            let next_right = left ^ f;
+            left = right;
+            right = next_right;
+        }
+
+        let pre_final = (u64::from(right) << 32) | u64::from(left);
+        permute(pre_final, 64, &FINAL_PERM)
+    }
+}

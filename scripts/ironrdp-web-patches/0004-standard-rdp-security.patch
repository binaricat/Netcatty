+fn permute(input: u64, input_bits: u32, table: &[u8]) -> u64 {
+    let mut out = 0u64;
+    for &pos in table {
+        let shift = input_bits - u32::from(pos);
+        out = (out << 1) | ((input >> shift) & 1);
+    }
+    out
+}

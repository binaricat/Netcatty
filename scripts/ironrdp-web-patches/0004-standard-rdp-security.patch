+    pub encrypted_client_random: Vec<u8>,
+}
+
+impl SecurityExchangePdu {
+    const NAME: &'static str = "SecurityExchangePdu";
+    const FIXED_PART_SIZE: usize = BASIC_SECURITY_HEADER_SIZE + 4;
+
+    pub fn new(encrypted_client_random: Vec<u8>) -> Self {
+        Self {
+            flags: BasicSecurityHeaderFlags::EXCHANGE_PKT,
+            encrypted_client_random,
+        }
+    }
+}
+
+impl Encode for SecurityExchangePdu {
+    fn encode(&self, dst: &mut WriteCursor<'_>) -> EncodeResult<()> {
+        ensure_size!(in: dst, size: self.size());
+        BasicSecurityHeader { flags: self.flags }.encode(dst)?;
+        dst.write_u32(cast_length!("encryptedClientRandomLen", self.encrypted_client_random.len(), in: dst)?);
+        dst.write_slice(&self.encrypted_client_random);
+        Ok(())
+    }
+
+    fn name(&self) -> &'static str {
+        Self::NAME
+    }
+
+    fn size(&self) -> usize {
+        Self::FIXED_PART_SIZE + self.encrypted_client_random.len()
+    }
+}
+
+impl<'de> Decode<'de> for SecurityExchangePdu {
+    fn decode(src: &mut ReadCursor<'de>) -> DecodeResult<Self> {
+        ensure_fixed_part_size!(in: src);
+        let security_header = BasicSecurityHeader::decode(src)?;
+        if !security_header.flags.contains(BasicSecurityHeaderFlags::EXCHANGE_PKT) {
+            return Err(invalid_field_err!(
+                "securityHeader",
+                "expected SEC_EXCHANGE_PKT flag in SecurityExchangePdu",
+                in: src
+            ));
+        }
+        let len: usize = cast_length!("encryptedClientRandomLen", src.read_u32(), in: src)?;
+        ensure_size!(in: src, size: len);
+        let encrypted_client_random = src.read_slice(len).to_vec();
+        Ok(Self {
+            flags: security_header.flags,
+            encrypted_client_random,
+        })
+    }
+}
+
+fn salted_hash(salt: &[u8; 48], input: &[u8], salt1: &[u8; 32], salt2: &[u8; 32]) -> [u8; 16] {
+    let mut sha = sha1::Sha1::new();
+    sha.update(input);
+    sha.update(salt);
+    sha.update(salt1);
+    sha.update(salt2);
+    let sha_digest = sha.finalize();
+
+    let mut md5 = md5::Md5::new();
+    md5.update(salt);
+    md5.update(sha_digest);
+    let digest = md5.finalize();
+    let mut out = [0u8; 16];
+    out.copy_from_slice(&digest);
+    out
+}
+
+fn final_hash(key: &[u8], client_random: &[u8; 32], server_random: &[u8; 32]) -> [u8; 16] {
+    let mut md5 = md5::Md5::new();
+    md5.update(key);
+    md5.update(client_random);
+    md5.update(server_random);
+    let digest = md5.finalize();
+    let mut out = [0u8; 16];
+    out.copy_from_slice(&digest);
+    out
+}
+
+fn hmac_sha1_8(key: &[u8], data: &[u8], use_count: u32) -> [u8; 8] {
+    // RFC 2104 HMAC-SHA1 with 64-byte block size
+    let mut key_block = [0u8; 64];
+    if key.len() > 64 {
+        let mut h = sha1::Sha1::new();
+        h.update(key);
+        key_block[..20].copy_from_slice(&h.finalize());
+    } else {
+        key_block[..key.len()].copy_from_slice(key);
+    }
+
+    let mut ipad = [0x36u8; 64];
+    let mut opad = [0x5Cu8; 64];
+    for i in 0..64 {
+        ipad[i] ^= key_block[i];
+        opad[i] ^= key_block[i];
+    }
+
+    let mut inner = sha1::Sha1::new();
+    inner.update(ipad);
+    inner.update(data);
+    inner.update(use_count.to_le_bytes());
+    let inner_digest = inner.finalize();
+
+    let mut outer = sha1::Sha1::new();
+    outer.update(opad);
+    outer.update(inner_digest);
+    let full = outer.finalize();
+
+    let mut out = [0u8; 8];
+    out.copy_from_slice(&full[..8]);
+    out
+}
+
+fn fips_expand_key_bits(input: &[u8; 21]) -> [u8; 24] {
+    let mut buf = [0u8; 21];
+    for (dst, &src) in buf.iter_mut().zip(input.iter()) {
+        *dst = FIPS_REVERSE_TABLE[usize::from(src)];
+    }
+
+    let mut out = [0u8; 24];
+    let mut b = 0usize;
+    for slot in &mut out {
+        let p = b / 8;
+        let r = b % 8;
+        if r <= 1 {
+            *slot = (buf[p] << r) & 0xFE;
+        } else {
+            let c = (buf[p] << r) | (buf[p + 1] >> (8 - r));
+            *slot = c & 0xFE;
+        }
+        b += 7;
+    }
+
+    for byte in &mut out {
+        *byte = FIPS_ODDPARITY_TABLE[usize::from(FIPS_REVERSE_TABLE[usize::from(*byte)])];
+    }
+    out
+}

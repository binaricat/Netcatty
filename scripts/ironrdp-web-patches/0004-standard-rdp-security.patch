+/// Stateful 3DES-EDE3-CBC cipher whose IV chains continuously across RDP packets
+/// per [MS-RDPBCGR] 5.3.6.1.3.
+#[derive(Clone)]
+pub(crate) struct TripleDesCbc {
+    k1: DesKey,
+    k2: DesKey,
+    k3: DesKey,
+    iv: u64,
+}
+
+impl TripleDesCbc {
+    pub(crate) fn new(key: &[u8; 24], iv: &[u8; 8]) -> Self {
+        let mut k1 = [0u8; 8];
+        let mut k2 = [0u8; 8];
+        let mut k3 = [0u8; 8];
+        k1.copy_from_slice(&key[0..8]);
+        k2.copy_from_slice(&key[8..16]);
+        k3.copy_from_slice(&key[16..24]);
+        Self {
+            k1: DesKey::new(k1),
+            k2: DesKey::new(k2),
+            k3: DesKey::new(k3),
+            iv: u64::from_be_bytes(*iv),
+        }
+    }
+
+    /// Encrypts `data` in place. `data.len()` must be a multiple of 8.
+    pub(crate) fn encrypt_in_place(&mut self, data: &mut [u8]) {
+        debug_assert!(data.len().is_multiple_of(8));
+        for chunk in data.chunks_exact_mut(8) {
+            let mut block_bytes = [0u8; 8];
+            block_bytes.copy_from_slice(chunk);
+            let xored = u64::from_be_bytes(block_bytes) ^ self.iv;
+            let e1 = self.k1.crypt_block(xored, false);
+            let d2 = self.k2.crypt_block(e1, true);
+            let e3 = self.k3.crypt_block(d2, false);
+            self.iv = e3;
+            chunk.copy_from_slice(&e3.to_be_bytes());
+        }
+    }
+
+    /// Decrypts `data` in place. `data.len()` must be a multiple of 8.
+    pub(crate) fn decrypt_in_place(&mut self, data: &mut [u8]) {
+        debug_assert!(data.len().is_multiple_of(8));
+        for chunk in data.chunks_exact_mut(8) {
+            let mut block_bytes = [0u8; 8];
+            block_bytes.copy_from_slice(chunk);
+            let ct = u64::from_be_bytes(block_bytes);
+            let d3 = self.k3.crypt_block(ct, true);
+            let e2 = self.k2.crypt_block(d3, false);
+            let d1 = self.k1.crypt_block(e2, true);
+            let pt = d1 ^ self.iv;
+            self.iv = ct;
+            chunk.copy_from_slice(&pt.to_be_bytes());
+        }
+    }
+}

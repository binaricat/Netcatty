+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn des_nist_known_answer() {
+        // FIPS 46-3 / NIST SP 800-17 standard test vector:
+        // Key: 0133457799BBCDFF, Plaintext: 0123456789ABCDEF -> Ciphertext: 85E813540F0AB405
+        let key = DesKey::new([0x13, 0x34, 0x57, 0x79, 0x9B, 0xBC, 0xDF, 0xF1]);
+        let pt = 0x0123_4567_89AB_CDEFu64;
+        let ct = key.crypt_block(pt, false);
+        assert_eq!(ct, 0x85E8_1354_0F0A_B405u64);
+        assert_eq!(key.crypt_block(ct, true), pt);
+    }
+
+    #[test]
+    fn tdes_cbc_roundtrip_and_chaining() {
+        // NIST SP 800-67 / known 3DES-EDE3-CBC vector:
+        let key: [u8; 24] = [
+            0x01, 0x23, 0x45, 0x67, 0x89, 0xAB, 0xCD, 0xEF, 0x23, 0x45, 0x67, 0x89, 0xAB, 0xCD, 0xEF, 0x01, 0x45, 0x67,
+            0x89, 0xAB, 0xCD, 0xEF, 0x01, 0x23,
+        ];
+        let iv: [u8; 8] = [0x12, 0x34, 0x56, 0x78, 0x90, 0xAB, 0xCD, 0xEF];
+        let plaintext = b"Now is the time for all ";
+        // Expected 3DES-EDE3-CBC output cross-verified against `openssl enc -des-ede3-cbc -nopad`:
+        let expected: [u8; 24] = [
+            0xF3, 0xC0, 0xFF, 0x02, 0x6C, 0x02, 0x30, 0x89, 0x65, 0x6F, 0xBB, 0x16, 0x9D, 0xEF, 0x7E, 0xDB, 0x30, 0xBA,
+            0x36, 0x07, 0x5D, 0x6F, 0x01, 0x76,
+        ];
+
+        let mut enc = TripleDesCbc::new(&key, &iv);
+        let mut buf = plaintext.to_vec();
+        enc.encrypt_in_place(&mut buf);
+        assert_eq!(buf.as_slice(), expected.as_slice());
+
+        // Verify continuous CBC chaining across two separate packet calls matches single-shot.
+        let mut enc_split = TripleDesCbc::new(&key, &iv);
+        let mut p1 = plaintext[0..8].to_vec();
+        let mut p2 = plaintext[8..24].to_vec();
+        enc_split.encrypt_in_place(&mut p1);
+        enc_split.encrypt_in_place(&mut p2);
+        assert_eq!([p1.as_slice(), p2.as_slice()].concat().as_slice(), expected.as_slice());
+
+        let mut dec = TripleDesCbc::new(&key, &iv);
+        dec.decrypt_in_place(&mut buf);
+        assert_eq!(buf.as_slice(), plaintext.as_slice());
+    }
+}

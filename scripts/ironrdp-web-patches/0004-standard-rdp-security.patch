+                cipher: c_enc,
+                message_channel_id,
+                encrypt_client_license: Arc::clone(&c_lic),
+                use_salted_checksum: false,
+            },
+            decryptor: StandardRdpDecryptor {
+                info,
+                cipher: c_dec,
+                encrypt_client_license: c_lic,
+            },
+        };
+        let server = Self {
+            encryptor: StandardRdpEncryptor {
+                info,
+                cipher: s_enc,
+                message_channel_id,
+                encrypt_client_license: Arc::clone(&s_lic),
+                use_salted_checksum: false,
+            },
+            decryptor: StandardRdpDecryptor {
+                info,
+                cipher: s_dec,
+                encrypt_client_license: s_lic,
+            },
+        };
+        (client, server)
+    }
+}
+
+/// Checks if a plaintext client `SendDataRequest.user_data` already begins with
+/// a `BasicSecurityHeader` (`INFO_PKT`, `LICENSE_PKT`, or message-channel PDU).
+fn detect_existing_client_security_header(
+    user_data: &[u8],
+    channel_id: u16,
+    message_channel_id: Option<u16>,
+) -> Option<BasicSecurityHeaderFlags> {
+    if user_data.len() < BASIC_SECURITY_HEADER_SIZE {
+        return None;
+    }
+    // IronRDP always encodes `flagsHi = 0` in BasicSecurityHeader, whereas
+    // ShareControlHeader always has non-zero pduType (version 0x10) at bytes [2..4].
+    if user_data[2] != 0 || user_data[3] != 0 {
+        return None;
+    }
+    let raw_flags = u16::from_le_bytes([user_data[0], user_data[1]]);
+    let flags = BasicSecurityHeaderFlags::from_bits_truncate(raw_flags);
+    if Some(channel_id) == message_channel_id {
+        if flags.intersects(
+            BasicSecurityHeaderFlags::AUTODETECT_REQ
+                | BasicSecurityHeaderFlags::AUTODETECT_RSP
+                | BasicSecurityHeaderFlags::HEARTBEAT
+                | BasicSecurityHeaderFlags::TRANSPORT_REQ
+                | BasicSecurityHeaderFlags::TRANSPORT_RSP,
+        ) {
+            return Some(flags);
+        }
+        return None;
+    }
+    if flags == BasicSecurityHeaderFlags::INFO_PKT
+        || flags == BasicSecurityHeaderFlags::LICENSE_PKT
+        || flags == BasicSecurityHeaderFlags::TRANSPORT_RSP
+    {
+        return Some(flags);
+    }
+    None
+}
+
+fn next_frame_len(buf: &[u8]) -> Result<usize, String> {
+    if buf.is_empty() {
+        return Ok(0);
+    }
+    if buf[0] == 0x03 {
+        if buf.len() < 4 {
+            return Err(String::from("truncated TPKT header"));
+        }
+        let len = usize::from(u16::from_be_bytes([buf[2], buf[3]]));
+        if len < 4 || len > buf.len() {
+            return Err(format!("invalid TPKT frame length {len} (buffer len {})", buf.len()));
+        }
+        Ok(len)
+    } else if (buf[0] & 0x03) == 0x00 {
+        if buf.len() < 2 {
+            return Err(String::from("truncated Fast-Path header"));
+        }
+        let mut cursor = ReadCursor::new(&buf[1..]);
+        let (len, _sz) = per::read_length(&mut cursor).map_err(|e| format!("invalid Fast-Path PER length: {e}"))?;
+        let len = usize::from(len);
+        if len < 2 || len > buf.len() {
+            return Err(format!("invalid Fast-Path frame length {len} (buffer len {})", buf.len()));
+        }
+        Ok(len)
+    } else {
+        Err(format!("unrecognized RDP frame leading byte 0x{:02x}", buf[0]))
+    }
+}
+
+fn encrypt_payload(
+    cipher: &mut DirectionCipher,
+    plaintext: &[u8],
+    salted: bool,
+    out: &mut Vec<u8>,
+) -> bool {
+    match cipher {
+        DirectionCipher::Rc4(rc4) => {
+            let (mac, ct) = rc4.encrypt(plaintext, salted);
+            out.extend_from_slice(&mac);
+            out.extend_from_slice(&ct);
+            salted
+        }
+        DirectionCipher::Fips(fips) => {
+            let (pad_len, mac, ct) = fips.encrypt(plaintext);
+            out.extend_from_slice(&FIPS_HEADER_LENGTH.to_le_bytes());
+            out.push(FIPS_VERSION_1);
+            out.push(pad_len);
+            out.extend_from_slice(&mac);
+            out.extend_from_slice(&ct);
+            false
+        }
+    }
+}
+
+fn decrypt_payload(
+    cipher: &mut DirectionCipher,
+    encrypted: &[u8],
+    salted: bool,
+) -> Result<Vec<u8>, String> {
+    match cipher {
+        DirectionCipher::Rc4(rc4) => {
+            if encrypted.len() < MAC_SIGNATURE_LEN {
+                return Err(String::from("Standard RDP RC4 payload shorter than 8-byte MAC"));
+            }
+            let mut mac = [0u8; 8];
+            mac.copy_from_slice(&encrypted[..MAC_SIGNATURE_LEN]);
+            rc4.decrypt(&encrypted[MAC_SIGNATURE_LEN..], &mac, salted)
+        }
+        DirectionCipher::Fips(fips) => {
+            if encrypted.len() < FIPS_INFO_LEN + MAC_SIGNATURE_LEN {
+                return Err(String::from("Standard RDP FIPS payload shorter than 12-byte FIPS header"));
+            }
+            let hdr_len = u16::from_le_bytes([encrypted[0], encrypted[1]]);
+            let version = encrypted[2];
+            let pad_len = encrypted[3];
+            if hdr_len != FIPS_HEADER_LENGTH || version != FIPS_VERSION_1 {
+                return Err(format!(
+                    "unexpected Standard RDP FIPS header (len=0x{hdr_len:04x}, version={version})"
+                ));
+            }
+            let mut mac = [0u8; 8];
+            mac.copy_from_slice(&encrypted[FIPS_INFO_LEN..FIPS_INFO_LEN + MAC_SIGNATURE_LEN]);
+            fips.decrypt(&encrypted[FIPS_INFO_LEN + MAC_SIGNATURE_LEN..], pad_len, &mac)
+        }
+    }
+}
+
+fn write_per_len_vec(dst: &mut Vec<u8>, len: usize) -> Result<(), String> {
+    let len_u16 = u16::try_from(len).map_err(|_| format!("Fast-Path length overflow: {len}"))?;
+    if len_u16 <= 0x7F {
+        dst.push(u8::try_from(len_u16).unwrap_or(0));
+    } else {
+        dst.push(u8::try_from((len_u16 >> 8) | 0x80).unwrap_or(0));
+        dst.push(u8::try_from(len_u16 & 0xFF).unwrap_or(0));
+    }
+    Ok(())
+}
+
+impl StandardRdpEncryptor {
+    pub fn info(&self) -> StandardRdpSecurityInfo {
+        self.info
+    }
+
+    pub fn set_use_salted_checksum(&mut self, enabled: bool) {
+        self.use_salted_checksum = enabled && !self.cipher.is_fips();
+    }
+
+    /// Encrypts a buffer containing one or more concatenated plaintext RDP frames
+    /// (TPKT Slow-Path or Fast-Path Input).
+    pub fn encrypt_frames(&mut self, plain_frames: &[u8]) -> Result<Vec<u8>, String> {
+        let mut out = Vec::with_capacity(plain_frames.len() + 32);
+        let mut offset = 0usize;
+        while offset < plain_frames.len() {
+            let frame_len = next_frame_len(&plain_frames[offset..])?;
+            let encrypted = self.encrypt_frame(&plain_frames[offset..offset + frame_len])?;
+            out.extend_from_slice(&encrypted);
+            offset += frame_len;
+        }
+        Ok(out)
+    }
+
+    /// Encrypts a single outbound plaintext RDP frame (TPKT or Fast-Path Input).
+    pub fn encrypt_frame(&mut self, plain_frame: &[u8]) -> Result<Vec<u8>, String> {
+        if plain_frame.is_empty() {
+            return Ok(Vec::new());
+        }
+
+        if plain_frame[0] == 0x03 {
+            let x224 = decode::<X224<McsMessage<'_>>>(plain_frame)
+                .map_err(|err| format!("failed to decode outbound MCS frame for encryption: {err}"))?
+                .0;
+            match x224 {
+                McsMessage::SendDataRequest(req) => {
+                    let user_data = req.user_data.as_ref();
+                    let existing_flags = detect_existing_client_security_header(
+                        user_data,
+                        req.channel_id,
+                        self.message_channel_id,
+                    );
+
+                    // Per [MS-RDPBCGR] 5.3.2, client licensing PDUs stay unencrypted
+                    // unless the server requested SEC_LICENSE_ENCRYPT_CS or FIPS is active.
+                    if existing_flags == Some(BasicSecurityHeaderFlags::LICENSE_PKT)
+                        && !self.cipher.is_fips()
+                        && !self.encrypt_client_license.load(Ordering::Acquire)
+                    {
+                        return Ok(plain_frame.to_vec());
+                    }
+
+                    let (mut flags, plaintext) = match existing_flags {
+                        Some(f) => (f, &user_data[BASIC_SECURITY_HEADER_SIZE..]),
+                        None => (BasicSecurityHeaderFlags::empty(), user_data),
+                    };
+
+                    flags.insert(BasicSecurityHeaderFlags::ENCRYPT);
+                    let salted = self.use_salted_checksum && !self.cipher.is_fips();
+                    if salted {
+                        flags.insert(BasicSecurityHeaderFlags::SECURE_CHECKSUM);
+                    }
+
+                    let mut encrypted_user_data = Vec::with_capacity(BASIC_SECURITY_HEADER_SIZE + 20 + plaintext.len());
+                    encrypted_user_data.extend_from_slice(&flags.bits().to_le_bytes());
+                    encrypted_user_data.extend_from_slice(&0u16.to_le_bytes());
+                    encrypt_payload(&mut self.cipher, plaintext, salted, &mut encrypted_user_data);
+
+                    let wrapped = McsMessage::SendDataRequest(SendDataRequest {
+                        initiator_id: req.initiator_id,
+                        channel_id: req.channel_id,
+                        user_data: Cow::Owned(encrypted_user_data),
+                    });
+                    encode_vec(&X224(wrapped))
+                        .map_err(|err| format!("failed to re-encode encrypted SendDataRequest: {err}"))
+                }
+                _ => Ok(plain_frame.to_vec()),
+            }
+        } else if (plain_frame[0] & 0x03) == 0x00 {
+            self.encrypt_fast_path_input(plain_frame)
+        } else {
+            Err(format!(
+                "unrecognized outbound RDP frame byte 0x{:02x}",
+                plain_frame[0]
+            ))
+        }
+    }
+
+    fn encrypt_fast_path_input(&mut self, plain_frame: &[u8]) -> Result<Vec<u8>, String> {
+        let mut cursor = ReadCursor::new(plain_frame);
+        let first_byte = cursor.read_u8();
+        let num_events_inline = first_byte.get_bits(2..6);
+        let (total_len, _len_size) =
+            per::read_length(&mut cursor).map_err(|e| format!("invalid Fast-Path input length: {e}"))?;
+        if usize::from(total_len) > plain_frame.len() {
+            return Err(String::from("truncated Fast-Path input frame"));
+        }
+        let extra_num_events = if num_events_inline == 0 {
+            if cursor.is_empty() {
+                return Err(String::from("Fast-Path input missing numEvents byte"));
+            }
+            Some(cursor.read_u8())
+        } else {
+            None
+        };
+        let header_consumed = plain_frame.len() - cursor.len();
+        let plaintext = &plain_frame[header_consumed..usize::from(total_len)];
+
+        let salted = self.use_salted_checksum && !self.cipher.is_fips();
+        let mut body = Vec::with_capacity(plaintext.len() + 20);
+        if let Some(n) = extra_num_events {
+            body.push(n);
+        }
+        encrypt_payload(&mut self.cipher, plaintext, salted, &mut body);
+
+        let mut enc_flags = EncryptionFlags::ENCRYPTED;
+        if salted {
+            enc_flags.insert(EncryptionFlags::SECURE_CHECKSUM);
+        }
+        let mut new_first_byte = 0u8;
+        new_first_byte.set_bits(0..2, 0);
+        new_first_byte.set_bits(2..6, num_events_inline);
+        new_first_byte.set_bits(6..8, enc_flags.bits());
+
+        let tentative = 1 + 1 + body.len();
+        let new_total_len = if tentative <= 0x7F { tentative } else { 1 + 2 + body.len() };
+
+        let mut out = Vec::with_capacity(new_total_len);
+        out.push(new_first_byte);
+        write_per_len_vec(&mut out, new_total_len)?;
+        out.extend_from_slice(&body);
+        Ok(out)
+    }
+
+    /// Server-side slow-path & fast-path encryption helper used in round-trip tests.
+    #[cfg(test)]
+    pub(crate) fn encrypt_server_frame_for_test(
+        &mut self,
+        plain_frame: &[u8],
+        extra_flags: BasicSecurityHeaderFlags,
+        flags_hi: u16,
+    ) -> Result<Vec<u8>, String> {
+        if self.info.encryption_level == EncryptionLevel::Low {
+            return Ok(plain_frame.to_vec());
+        }
+        if plain_frame[0] == 0x03 {
+            let x224 = decode::<X224<McsMessage<'_>>>(plain_frame).unwrap().0;
+            let McsMessage::SendDataIndication(ind) = x224 else {
+                return Ok(plain_frame.to_vec());
+            };
+            let user_data = ind.user_data.as_ref();
+            let (base_flags, plaintext) = if !extra_flags.is_empty() && user_data.len() >= BASIC_SECURITY_HEADER_SIZE {
+                let hdr = decode::<BasicSecurityHeader>(&user_data[..BASIC_SECURITY_HEADER_SIZE]).unwrap();
+                (hdr.flags | extra_flags, &user_data[BASIC_SECURITY_HEADER_SIZE..])
+            } else {
+                (BasicSecurityHeaderFlags::empty(), user_data)
+            };
+            let mut flags = base_flags | BasicSecurityHeaderFlags::ENCRYPT;
+            let salted = self.use_salted_checksum && !self.cipher.is_fips();
+            if salted {
+                flags.insert(BasicSecurityHeaderFlags::SECURE_CHECKSUM);
+            }
+            let mut enc_user_data = Vec::new();
+            enc_user_data.extend_from_slice(&flags.bits().to_le_bytes());
+            enc_user_data.extend_from_slice(&flags_hi.to_le_bytes());
+            encrypt_payload(&mut self.cipher, plaintext, salted, &mut enc_user_data);
+            let wrapped = McsMessage::SendDataIndication(SendDataIndication {
+                initiator_id: ind.initiator_id,
+                channel_id: ind.channel_id,
+                user_data: Cow::Owned(enc_user_data),
+            });
+            encode_vec(&X224(wrapped)).map_err(|e| format!("{e}"))
+        } else {
+            let mut cursor = ReadCursor::new(plain_frame);
+            let header = FastPathHeader::decode(&mut cursor).map_err(|e| format!("{e}"))?;
+            let plaintext = cursor.read_slice(header.data_length);
+            let salted = self.use_salted_checksum && !self.cipher.is_fips();
+            let mut body = Vec::new();
+            encrypt_payload(&mut self.cipher, plaintext, salted, &mut body);
+            let mut flags = EncryptionFlags::ENCRYPTED;
+            if salted {
+                flags.insert(EncryptionFlags::SECURE_CHECKSUM);
+            }
+            let new_hdr = FastPathHeader::new(flags, body.len());
+            let mut out = encode_vec(&new_hdr).map_err(|e| format!("{e}"))?;
+            out.extend_from_slice(&body);
+            Ok(out)
+        }
+    }
+}
+
+impl StandardRdpDecryptor {
+    pub fn info(&self) -> StandardRdpSecurityInfo {
+        self.info
+    }
+
+    /// Decrypts a single inbound wire RDP frame (TPKT Slow-Path or Fast-Path Output).
+    pub fn decrypt_frame(&mut self, wire_frame: &[u8]) -> Result<Vec<u8>, String> {
+        if wire_frame.is_empty() {
+            return Ok(Vec::new());
+        }
+
+        // Under ENCRYPTION_LEVEL_LOW only client -> server traffic is encrypted.
+        if self.info.encryption_level == EncryptionLevel::Low {
+            return Ok(wire_frame.to_vec());
+        }
+
+        if wire_frame[0] == 0x03 {
+            let x224 = decode::<X224<McsMessage<'_>>>(wire_frame)
+                .map_err(|err| format!("failed to decode inbound MCS frame for decryption: {err}"))?
+                .0;
+            match x224 {
+                McsMessage::SendDataIndication(ind) => {
+                    let user_data = ind.user_data.as_ref();
+                    if user_data.len() < BASIC_SECURITY_HEADER_SIZE {
+                        return Err(String::from("inbound Standard RDP SendDataIndication missing security header"));
+                    }
+                    // Ignore flagsHi (Windows 2003 R2 populates non-zero bytes such as 0x0302).
+                    let raw_flags = u16::from_le_bytes([user_data[0], user_data[1]]);
+                    let flags = BasicSecurityHeaderFlags::from_bits_truncate(raw_flags);
+
+                    if flags.contains(BasicSecurityHeaderFlags::LICENSE_ENCRYPT_CS) {
+                        self.encrypt_client_license.store(true, Ordering::Release);
+                    }
+
+                    if !flags.contains(BasicSecurityHeaderFlags::ENCRYPT) {
+                        return Ok(wire_frame.to_vec());
+                    }
+
+                    let salted = flags.contains(BasicSecurityHeaderFlags::SECURE_CHECKSUM);
+                    let plaintext = decrypt_payload(&mut self.cipher, &user_data[BASIC_SECURITY_HEADER_SIZE..], salted)?;
+
+                    let preserved = flags.intersection(PRESERVED_SECURITY_HEADER_FLAGS);
+                    let plain_user_data = if !preserved.is_empty() {
+                        let mut buf = Vec::with_capacity(BASIC_SECURITY_HEADER_SIZE + plaintext.len());
+                        buf.extend_from_slice(&preserved.bits().to_le_bytes());
+                        buf.extend_from_slice(&0u16.to_le_bytes());
+                        buf.extend_from_slice(&plaintext);
+                        buf
+                    } else {
+                        plaintext
+                    };
+
+                    let unwrapped = McsMessage::SendDataIndication(SendDataIndication {
+                        initiator_id: ind.initiator_id,
+                        channel_id: ind.channel_id,
+                        user_data: Cow::Owned(plain_user_data),
+                    });
+                    encode_vec(&X224(unwrapped))
+                        .map_err(|err| format!("failed to re-encode decrypted SendDataIndication: {err}"))
+                }
+                _ => Ok(wire_frame.to_vec()),
+            }
+        } else if (wire_frame[0] & 0x03) == 0x00 {
+            self.decrypt_fast_path_output(wire_frame)
+        } else {
+            Err(format!("unrecognized inbound RDP frame byte 0x{:02x}", wire_frame[0]))
+        }
+    }
+
+    fn decrypt_fast_path_output(&mut self, wire_frame: &[u8]) -> Result<Vec<u8>, String> {
+        let mut cursor = ReadCursor::new(wire_frame);
+        let header = FastPathHeader::decode(&mut cursor)
+            .map_err(|err| format!("failed to decode inbound Fast-Path header: {err}"))?;
+        if !header.flags.contains(EncryptionFlags::ENCRYPTED) {
+            return Ok(wire_frame.to_vec());
+        }
+        if cursor.len() < header.data_length {
+            return Err(String::from("truncated encrypted Fast-Path output frame"));
+        }
+        let encrypted = cursor.read_slice(header.data_length);
+        let salted = header.flags.contains(EncryptionFlags::SECURE_CHECKSUM);
+        let plaintext = decrypt_payload(&mut self.cipher, encrypted, salted)?;
+        let plain_header = FastPathHeader::new(EncryptionFlags::empty(), plaintext.len());
+        let mut out = encode_vec(&plain_header)
+            .map_err(|err| format!("failed to re-encode decrypted Fast-Path header: {err}"))?;
+        out.extend_from_slice(&plaintext);
+        Ok(out)
+    }
+
+    /// Server-side decrypt helper used in unit tests to verify client -> server frames.
+    #[cfg(test)]
+    pub(crate) fn decrypt_client_frame_for_test(&mut self, wire_frame: &[u8]) -> Result<Vec<u8>, String> {
+        if wire_frame[0] == 0x03 {
+            let x224 = decode::<X224<McsMessage<'_>>>(wire_frame).map_err(|e| format!("{e}"))?.0;
+            let McsMessage::SendDataRequest(req) = x224 else {
+                return Ok(wire_frame.to_vec());
+            };
+            let user_data = req.user_data.as_ref();
+            let raw_flags = u16::from_le_bytes([user_data[0], user_data[1]]);
+            let flags = BasicSecurityHeaderFlags::from_bits_truncate(raw_flags);
+            if !flags.contains(BasicSecurityHeaderFlags::ENCRYPT) {
+                return Ok(wire_frame.to_vec());
+            }
+            let salted = flags.contains(BasicSecurityHeaderFlags::SECURE_CHECKSUM);
+            let plaintext = decrypt_payload(&mut self.cipher, &user_data[BASIC_SECURITY_HEADER_SIZE..], salted)?;
+            let preserved = flags.intersection(PRESERVED_SECURITY_HEADER_FLAGS);
+            let plain_user_data = if !preserved.is_empty() {
+                let mut buf = Vec::with_capacity(BASIC_SECURITY_HEADER_SIZE + plaintext.len());
+                buf.extend_from_slice(&preserved.bits().to_le_bytes());
+                buf.extend_from_slice(&0u16.to_le_bytes());
+                buf.extend_from_slice(&plaintext);
+                buf
+            } else {
+                plaintext
+            };
+            encode_vec(&X224(McsMessage::SendDataRequest(SendDataRequest {
+                initiator_id: req.initiator_id,
+                channel_id: req.channel_id,
+                user_data: Cow::Owned(plain_user_data),
+            })))
+            .map_err(|e| format!("{e}"))
+        } else {
+            let mut cursor = ReadCursor::new(wire_frame);
+            let first = cursor.read_u8();
+            let flags = EncryptionFlags::from_bits_retain(first.get_bits(6..8));
+            let num_events_inline = first.get_bits(2..6);
+            let (total_len, _) = per::read_length(&mut cursor).map_err(|e| format!("{e}"))?;
+            let extra_num = if num_events_inline == 0 {
+                Some(cursor.read_u8())
+            } else {
+                None
+            };
+            let consumed = wire_frame.len() - cursor.len();
+            let encrypted = &wire_frame[consumed..usize::from(total_len)];
+            let salted = flags.contains(EncryptionFlags::SECURE_CHECKSUM);
+            let plaintext = decrypt_payload(&mut self.cipher, encrypted, salted)?;
+            let mut body = Vec::new();
+            if let Some(n) = extra_num {
+                body.push(n);
+            }
+            body.extend_from_slice(&plaintext);
+            let tentative = 1 + 1 + body.len();
+            let new_len = if tentative <= 0x7F { tentative } else { 1 + 2 + body.len() };
+            let mut out = Vec::with_capacity(new_len);
+            let mut plain_first = 0u8;
+            plain_first.set_bits(2..6, num_events_inline);
+            out.push(plain_first);
+            write_per_len_vec(&mut out, new_len)?;
+            out.extend_from_slice(&body);
+            Ok(out)
+        }
+    }
+}

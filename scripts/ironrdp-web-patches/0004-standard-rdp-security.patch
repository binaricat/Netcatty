+        assert_eq!(encoded[0], 0x00);
+        assert_eq!(&encoded[1..7], &[5, 0, 20, 124, 0, 1]);
+        assert_ne!(encoded[7] & 0x80, 0, "expected 2-byte PER length");
+        let declared_connect_pdu_len = (usize::from(encoded[7] & 0x7F) << 8) | usize::from(encoded[8]);
+        assert_eq!(
+            declared_connect_pdu_len,
+            encoded.len() - 9,
+            "ConnectData.connectPDU length must equal exact remaining bytes"
+        );
+    }

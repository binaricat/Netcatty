+fn derive_direction_ciphers(
+    method: EncryptionMethod,
+    client_random: &[u8; 32],
+    server_random: &[u8; 32],
+    is_server: bool,
+) -> Result<(DirectionCipher, DirectionCipher), String> {
+    if method == EncryptionMethod::FIPS {
+        let mut client_encrypt_key_t = [0u8; 21];
+        let mut sha = sha1::Sha1::new();
+        sha.update(&client_random[16..32]);
+        sha.update(&server_random[16..32]);
+        client_encrypt_key_t[..20].copy_from_slice(&sha.finalize());
+        client_encrypt_key_t[20] = client_encrypt_key_t[0];
+
+        let mut client_decrypt_key_t = [0u8; 21];
+        let mut sha = sha1::Sha1::new();
+        sha.update(&client_random[0..16]);
+        sha.update(&server_random[0..16]);
+        client_decrypt_key_t[..20].copy_from_slice(&sha.finalize());
+        client_decrypt_key_t[20] = client_decrypt_key_t[0];
+
+        let mut sign_key = [0u8; 20];
+        let mut sha = sha1::Sha1::new();
+        sha.update(&client_decrypt_key_t[..20]);
+        sha.update(&client_encrypt_key_t[..20]);
+        sign_key.copy_from_slice(&sha.finalize());
+
+        let c2s_key = fips_expand_key_bits(&client_encrypt_key_t);
+        let s2c_key = fips_expand_key_bits(&client_decrypt_key_t);
+
+        let (enc_key, dec_key) = if is_server {
+            (s2c_key, c2s_key)
+        } else {
+            (c2s_key, s2c_key)
+        };
+
+        return Ok((
+            DirectionCipher::Fips(FipsDirectionState::new(sign_key, enc_key)),
+            DirectionCipher::Fips(FipsDirectionState::new(sign_key, dec_key)),
+        ));
+    }
+
+    let key_len = match method {
+        EncryptionMethod::BIT_40 | EncryptionMethod::BIT_56 => 8,
+        EncryptionMethod::BIT_128 => 16,
+        _ => return Err(format!("unsupported Standard RDP encryption method: {method:?}")),
+    };
+
+    let mut pre_master_secret = [0u8; 48];
+    pre_master_secret[..24].copy_from_slice(&client_random[..24]);
+    pre_master_secret[24..].copy_from_slice(&server_random[..24]);
+
+    let mut master_secret = [0u8; 48];
+    master_secret[0..16].copy_from_slice(&salted_hash(&pre_master_secret, b"A", client_random, server_random));
+    master_secret[16..32].copy_from_slice(&salted_hash(&pre_master_secret, b"BB", client_random, server_random));
+    master_secret[32..48].copy_from_slice(&salted_hash(&pre_master_secret, b"CCC", client_random, server_random));
+
+    let mut session_key_blob = [0u8; 48];
+    session_key_blob[0..16].copy_from_slice(&salted_hash(&master_secret, b"X", client_random, server_random));
+    session_key_blob[16..32].copy_from_slice(&salted_hash(&master_secret, b"YY", client_random, server_random));
+    session_key_blob[32..48].copy_from_slice(&salted_hash(&master_secret, b"ZZZ", client_random, server_random));
+
+    let mut mac_key = [0u8; 16];
+    mac_key.copy_from_slice(&session_key_blob[0..16]);
+
+    let mut s2c_key = final_hash(&session_key_blob[16..32], client_random, server_random);
+    let mut c2s_key = final_hash(&session_key_blob[32..48], client_random, server_random);
+
+    if method == EncryptionMethod::BIT_40 {
+        mac_key[..3].copy_from_slice(&SALT_40_56);
+        s2c_key[..3].copy_from_slice(&SALT_40_56);
+        c2s_key[..3].copy_from_slice(&SALT_40_56);
+    } else if method == EncryptionMethod::BIT_56 {
+        mac_key[0] = SALT_40_56[0];
+        s2c_key[0] = SALT_40_56[0];
+        c2s_key[0] = SALT_40_56[0];
+    }
+
+    let (enc_key, dec_key) = if is_server {
+        (s2c_key, c2s_key)
+    } else {
+        (c2s_key, s2c_key)
+    };
+
+    Ok((
+        DirectionCipher::Rc4(Rc4DirectionState::new(method, key_len, mac_key, enc_key)),
+        DirectionCipher::Rc4(Rc4DirectionState::new(method, key_len, mac_key, dec_key)),
+    ))
+}
+
+/// Encrypts the 32-byte `client_random` with the RSA public key embedded in
+/// `SC_SECURITY.server_cert` (`SERVER_CERTIFICATE`, proprietary or X.509).
+pub fn encrypt_client_random_with_server_cert(
+    server_cert_bytes: &[u8],
+    client_random: &[u8; 32],
+) -> Result<Vec<u8>, String> {
+    let cert = decode::<ServerCertificate>(server_cert_bytes)
+        .map_err(|err| format!("failed to decode Standard RDP server certificate: {err}"))?;
+
+    match &cert.certificate {
+        CertificateType::Proprietary(prop) => encrypt_with_modulus_exponent(
+            client_random,
+            &prop.public_key.modulus,
+            prop.public_key.public_exponent,
+        )
+        .map_err(|err| format!("failed to RSA-encrypt client random with proprietary cert: {err}")),
+        CertificateType::X509(_) => {
+            let public_key_der = cert
+                .get_public_key()
+                .map_err(|err| format!("failed to extract X.509 public key: {err:?}"))?;
+            encrypt_with_public_key(client_random, &public_key_der)
+                .map_err(|err| format!("failed to RSA-encrypt client random with X.509 cert: {err}"))
+        }
+    }
+}

+fn standard_rdp_method_label(method: EncryptionMethod) -> &'static str {
+    if method == EncryptionMethod::BIT_128 {
+        "rc4-128"
+    } else if method == EncryptionMethod::BIT_56 {
+        "rc4-56"
+    } else if method == EncryptionMethod::BIT_40 {
+        "rc4-40"
+    } else if method == EncryptionMethod::FIPS {
+        "fips"
+    } else {
+        "none"
+    }
+}
+
+fn standard_rdp_level_label(level: EncryptionLevel) -> &'static str {
+    match level {
+        EncryptionLevel::None => "none",
+        EncryptionLevel::Low => "low",
+        EncryptionLevel::ClientCompatible => "client-compatible",
+        EncryptionLevel::High => "high",
+        EncryptionLevel::Fips => "fips",
+    }
+}

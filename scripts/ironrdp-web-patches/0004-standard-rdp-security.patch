+impl StandardRdpSecurity {
+    /// Initializes client-side Standard RDP Security from the server's `SC_SECURITY`
+    /// block and a freshly generated 32-byte `client_random`, returning both the
+    /// active security context and the `SecurityExchangePdu` to transmit.
+    pub fn new_client(
+        server_security: &ServerSecurityData,
+        client_random: [u8; 32],
+        message_channel_id: Option<u16>,
+    ) -> Result<(Self, SecurityExchangePdu), String> {
+        if server_security.encryption_level == EncryptionLevel::None || server_security.encryption_method.is_empty() {
+            return Err(String::from(
+                "cannot initialize Standard RDP encryption for ENCRYPTION_LEVEL_NONE",
+            ));
+        }
+
+        let server_random = server_security
+            .server_random
+            .as_ref()
+            .ok_or_else(|| String::from("SC_SECURITY missing 32-byte server random"))?;
+        if server_security.server_cert.is_empty() {
+            return Err(String::from("SC_SECURITY missing server certificate"));
+        }
+
+        let encrypted_client_random =
+            encrypt_client_random_with_server_cert(&server_security.server_cert, &client_random)?;
+
+        let (encrypt_cipher, decrypt_cipher) = derive_direction_ciphers(
+            server_security.encryption_method,
+            &client_random,
+            server_random,
+            false,
+        )?;
+
+        let info = StandardRdpSecurityInfo {
+            encryption_method: server_security.encryption_method,
+            encryption_level: server_security.encryption_level,
+        };
+        let encrypt_client_license = Arc::new(AtomicBool::new(
+            server_security.encryption_method == EncryptionMethod::FIPS,
+        ));
+
+        let security = Self {
+            encryptor: StandardRdpEncryptor {
+                info,
+                cipher: encrypt_cipher,
+                message_channel_id,
+                encrypt_client_license: Arc::clone(&encrypt_client_license),
+                use_salted_checksum: false,
+            },
+            decryptor: StandardRdpDecryptor {
+                info,
+                cipher: decrypt_cipher,
+                encrypt_client_license,
+            },
+        };
+
+        Ok((security, SecurityExchangePdu::new(encrypted_client_random)))
+    }
+
+    pub fn info(&self) -> StandardRdpSecurityInfo {
+        self.encryptor.info
+    }
+
+    pub fn encrypt_frame(&mut self, plain_frame: &[u8]) -> Result<Vec<u8>, String> {
+        self.encryptor.encrypt_frame(plain_frame)
+    }
+
+    pub fn encrypt_frames(&mut self, plain_frames: &[u8]) -> Result<Vec<u8>, String> {
+        self.encryptor.encrypt_frames(plain_frames)
+    }
+
+    pub fn decrypt_frame(&mut self, wire_frame: &[u8]) -> Result<Vec<u8>, String> {
+        self.decryptor.decrypt_frame(wire_frame)

+/// Encrypts `message` using a raw little-endian RSA modulus (with MS-RDPBCGR
+/// 8-byte trailing zero padding) and 32-bit public exponent, returning the
+/// little-endian ciphertext padded to `modulus_bytes + 8` bytes.
+pub(crate) fn encrypt_with_modulus_exponent(
+    message: &[u8],
+    modulus_le_with_padding: &[u8],
+    exponent: u32,
+) -> io::Result<Vec<u8>> {
+    if modulus_le_with_padding.len() <= 8 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "RSA proprietary modulus is too short",
+        ));
+    }
+    let modulus_raw = &modulus_le_with_padding[..modulus_le_with_padding.len() - 8];
+    let n = BigUint::from_bytes_le(modulus_raw);
+    if n.bits() < MIN_MODULUS_BITS {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            format!("RSA public key modulus is shorter than {MIN_MODULUS_BITS} bits"),
+        ));
+    }
+    let e = BigUint::from(exponent);
+    let m = BigUint::from_bytes_le(message);
+    let c = m.modpow(&e, &n);
+
+    let mut result = c.to_bytes_le();
+    result.resize(modulus_raw.len() + 8, 0u8);
 
     Ok(result)
 }

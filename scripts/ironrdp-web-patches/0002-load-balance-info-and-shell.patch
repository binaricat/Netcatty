+/// Routes a caller-supplied `load_balance_info` string to the appropriate X.224
+/// negotiation field:
+/// - `Cookie: msts=<token>` or `msts=<token>` -> `config.request_data = Some(NegoRequestData::routing_token(<token>))`
+/// - Any other printable routing info (e.g. `tsv://MS Terminal Services Plugin.1.<Collection>`,
+///   `Cookie: tsv://...`, or JumpServer/broker tokens) -> returned for `ClientConnector::with_load_balance_info`.
+fn apply_load_balance_info(config: &mut connector::Config, load_balance_info: Option<String>) -> Option<String> {
+    let raw = load_balance_info?;
+    let trimmed = raw.trim_end_matches(['\r', '\n']);
+    if trimmed.is_empty() {
+        return None;
+    }
+
+    if let Some(token) = trimmed
+        .strip_prefix("Cookie: msts=")
+        .or_else(|| trimmed.strip_prefix("msts="))
+    {
+        if !token.is_empty() {
+            config.request_data = Some(ironrdp::pdu::nego::NegoRequestData::routing_token(token.to_owned()));
+            return None;
+        }
+    }
+
+    Some(trimmed.to_owned())
+}

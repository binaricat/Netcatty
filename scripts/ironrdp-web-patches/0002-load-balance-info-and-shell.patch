+    #[test]
+    fn test_apply_load_balance_info_routing_token_and_opaque() {
+        let sec = SecurityConfig {
+            enable_credssp: true,
+            enable_standard_rdp_security: false,
+        };
+
+        let mut cfg_msts = connector_config(false, sec);
+        let opaque = apply_load_balance_info(&mut cfg_msts, Some("Cookie: msts=3640205228.15629.0000\r\n".to_owned()));
+        assert_eq!(opaque, None);
+        assert_eq!(
+            cfg_msts.request_data,
+            Some(ironrdp::pdu::nego::NegoRequestData::routing_token(
+                "3640205228.15629.0000".to_owned()
+            ))
+        );
+
+        let mut cfg_short_msts = connector_config(false, sec);
+        let opaque = apply_load_balance_info(&mut cfg_short_msts, Some("msts=1234.5678.0000".to_owned()));
+        assert_eq!(opaque, None);
+        assert_eq!(
+            cfg_short_msts.request_data,
+            Some(ironrdp::pdu::nego::NegoRequestData::routing_token(
+                "1234.5678.0000".to_owned()
+            ))
+        );
+
+        let mut cfg_tsv = connector_config(false, sec);
+        let opaque = apply_load_balance_info(
+            &mut cfg_tsv,
+            Some("tsv://MS Terminal Services Plugin.1.MyCollection\r\n".to_owned()),
+        );
+        assert_eq!(cfg_tsv.request_data, None);
+        assert_eq!(
+            opaque.as_deref(),
+            Some("tsv://MS Terminal Services Plugin.1.MyCollection")
+        );
+
+        let mut cfg_empty = connector_config(false, sec);
+        assert_eq!(apply_load_balance_info(&mut cfg_empty, Some("\r\n".to_owned())), None);
+        assert_eq!(cfg_empty.request_data, None);
+    }

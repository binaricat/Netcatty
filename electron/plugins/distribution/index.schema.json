{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "plugins"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "plugins": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "current",
          "versions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[a-z0-9][a-z0-9.-]+$"
          },
          "current": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entry",
                "distribution",
                "withdrawal"
              ],
              "properties": {
                "entry": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "version",
                    "name",
                    "description",
                    "author",
                    "repository",
                    "commit",
                    "license",
                    "readme",
                    "manifest"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "^[a-z0-9][a-z0-9.-]+$"
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "author": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "repository": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                    },
                    "commit": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "^[a-f0-9]{40}$"
                    },
                    "license": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "readme": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "manifest": {
                      "$ref": "https://netcatty.com/schemas/plugins/0.1.0-internal.1/plugin-contract.schema.json"
                    },
                    "artifact": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "url",
                        "sha256"
                      ],
                      "properties": {
                        "url": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      }
                    }
                  }
                },
                "distribution": {
                  "enum": [
                    "source-only",
                    "release"
                  ]
                },
                "tag": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                "withdrawal": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "at",
                        "reason",
                        "advisory"
                      ],
                      "properties": {
                        "at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        "advisory": {
                          "type": "string",
                          "pattern": "^https://github.com/"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Netcatty static delivery v1 (source-only bootstrap)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registryCommit",
    "plugins",
    "catalogSha256",
    "indexSha256",
    "sourceLockSha256",
    "builderSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "registryCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "plugins": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "repository",
          "commit",
          "readme",
          "iconLight",
          "iconDark",
          "avatar",
          "artifact"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "readme": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "size"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/assets/[a-f0-9]{64}\\.(md|png|webp|ncpkg)$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 262144
              }
            }
          },
          "iconLight": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "size"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^/assets/[a-f0-9]{64}\\.(md|png|webp|ncpkg)$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 262144
                  }
                }
              }
            ]
          },
          "iconDark": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "size"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^/assets/[a-f0-9]{64}\\.(md|png|webp|ncpkg)$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 262144
                  }
                }
              }
            ]
          },
          "avatar": {
            "type": "null"
          },
          "artifact": {
            "type": "null"
          }
        }
      }
    },
    "catalogSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "indexSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceLockSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "builderSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
